<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <UserSecretsId>HomePlant-LocalDevelopment</UserSecretsId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FirebaseAdmin" Version="3.5.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.74.0" />
    <PackageReference Include="Google.Cloud.Firestore" Version="4.2.0" />
    <PackageReference Include="payOS" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Update="appsettings.Development.json;appsettings.Example.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Compile Remove="Tests/**" />
    <Content Remove="Firebase/**;Seed/**;3D_UI/**;docs/**;Tests/**" />
    <None Remove="Firebase/**;Seed/**;3D_UI/**;docs/**;Tests/**" />
    <Content Include="3D_UI/index.html;3D_UI/assets/**;3D_UI/render_output/**"
             Exclude="**/*.bak;**/.DS_Store">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Firebase\" />
  </ItemGroup>

</Project>
