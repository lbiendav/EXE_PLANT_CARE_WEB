@model HomePlant.Models.AiDiagnosisModel

@{
    ViewData["Title"] = "Kết quả tư vấn";
    var result = Model.Result ?? new HomePlant.Models.AiDiagnosisResultModel();
    var confidence = Math.Round(Math.Clamp(result.Confidence, 0, 1) * 100);
    var observations = result.Observations ?? new List<string>();
    var immediateActions = result.ImmediateActions ?? new List<string>();
    var sevenDayPlan = result.SevenDayPlan ?? new List<string>();
    var warnings = result.Warnings ?? new List<string>();
    var careRecommendations = result.CareRecommendations ?? new HomePlant.Models.AiCareRecommendationsModel();
    var wateringRecommendation = careRecommendations.Watering ?? new HomePlant.Models.AiCareFrequencyModel();
    var fertilizingRecommendation = careRecommendations.Fertilizing ?? new HomePlant.Models.AiCareFrequencyModel();
    var repottingRecommendation = careRecommendations.Repotting ?? new HomePlant.Models.AiCareFrequencyModel();
    var hasCareRecommendations =
        wateringRecommendation.Frequency > 0 &&
        fertilizingRecommendation.Frequency > 0 &&
        repottingRecommendation.Frequency > 0;
    var canApplyRecommendations =
        (ViewBag.LinkedPlantExists as bool?) == true &&
        HomePlant.Services.CareScheduleCalculator.TryCreateSchedule(careRecommendations, out _);
}

<a asp-action="Index" class="back-link">← Chuyên gia</a>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="kicker">Kết quả phân tích</span>
        <h1 class="mb-2">@(string.IsNullOrWhiteSpace(result.DiseaseName) ? "Tư vấn chăm sóc cây" : result.DiseaseName)</h1>
        <p class="text-muted mb-0">
            @Model.PlantName · @Model.CreatedAt.ToDateTime().AddHours(7).ToString("dd/MM/yyyy HH:mm")
        </p>
    </div>
    <div class="expert-confidence">
        <small>Mức tin cậy</small>
        <strong>@confidence%</strong>
    </div>
</div>

<div class="row g-4 align-items-start">
    <div class="col-lg-5">
        @if (!string.IsNullOrWhiteSpace(Model.UploadedImageUrl))
        {
            <div class="detail-hero expert-result-image">
                <img src="@Model.UploadedImageUrl" alt="Ảnh cây được gửi để phân tích" />
            </div>
        }

        <div class="card mt-3">
            <div class="card-body p-4">
                <span class="kicker">Bạn đã hỏi</span>
                <p class="mb-0">@Model.Question</p>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card mb-3 expert-answer-card">
            <div class="card-body p-4">
                <span class="kicker">Nhận định nhanh</span>
                <p class="lead mb-3">@result.Summary</p>
                @if (!string.IsNullOrWhiteSpace(result.Cause))
                {
                    <p class="mb-0"><strong>Nguyên nhân có thể:</strong> @result.Cause</p>
                }
            </div>
        </div>

        @if (observations.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-body p-4">
                    <h6 class="kicker">Dấu hiệu quan sát được</h6>
                    <ul class="expert-answer-list mb-0">
                        @foreach (var item in observations) { <li>@item</li> }
                    </ul>
                </div>
            </div>
        }

        <div class="card mb-3">
            <div class="card-body p-4">
                <h6 class="kicker">Việc nên làm ngay</h6>
                @if (immediateActions.Count > 0)
                {
                    <ul class="expert-answer-list mb-3">
                        @foreach (var item in immediateActions) { <li>@item</li> }
                    </ul>
                }
                <p class="mb-0">@result.Treatment</p>
            </div>
        </div>

        @if (sevenDayPlan.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-body p-4">
                    <h6 class="kicker">Kế hoạch 7 ngày</h6>
                    <ol class="expert-answer-list mb-0">
                        @foreach (var item in sevenDayPlan) { <li>@item</li> }
                    </ol>
                </div>
            </div>
        }

        @if (hasCareRecommendations)
        {
            <div class="card mb-3 expert-care-recommendations">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                        <div>
                            <h6 class="kicker mb-2">Lịch chăm sóc AI khuyến nghị</h6>
                            @if (!string.IsNullOrWhiteSpace(result.IdentifiedPlant))
                            {
                                <p class="mb-0">Dựa trên loại cây: <strong>@result.IdentifiedPlant</strong></p>
                            }
                        </div>
                        @if (Model.CareRecommendationsAppliedAt.HasValue)
                        {
                            <span class="expert-applied-badge">Đã áp dụng</span>
                        }
                    </div>

                    <div class="expert-care-grid">
                        @foreach (var item in new[]
                        {
                            new { Icon = "💧", Label = "Tưới nước", Value = wateringRecommendation },
                            new { Icon = "✦", Label = "Bón phân", Value = fertilizingRecommendation },
                            new { Icon = "♻", Label = "Thay chậu", Value = repottingRecommendation }
                        })
                        {
                            <div class="expert-care-item">
                                <span class="expert-care-icon" aria-hidden="true">@item.Icon</span>
                                <div>
                                    <small>@item.Label</small>
                                    <strong>Mỗi @item.Value.Frequency @HomePlant.Services.CareScheduleCalculator.UnitLabel(item.Value.Unit)</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.Value.Reason))
                                    {
                                        <p>@item.Value.Reason</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(careRecommendations.GeneralNote))
                    {
                        <p class="expert-care-note">@careRecommendations.GeneralNote</p>
                    }

                    @if (string.IsNullOrWhiteSpace(Model.PlantId))
                    {
                        <div class="alert alert-warning mb-0">
                            Muốn áp dụng lịch này, hãy thêm cây vào vườn rồi phân tích lại và chọn đúng cây.
                            <a asp-controller="Plant" asp-action="Create" class="alert-link">Thêm cây vào vườn</a>
                        </div>
                    }
                    else if (!careRecommendations.IsSuitableForAutomation)
                    {
                        <div class="alert alert-warning mb-0">
                            AI chưa đủ tự tin để tự động tạo lịch. Hãy bổ sung ảnh hoặc thông tin rõ hơn.
                        </div>
                    }
                    else if ((ViewBag.LinkedPlantExists as bool?) != true)
                    {
                        <div class="alert alert-warning mb-0">Cây liên kết với phiên tư vấn này không còn tồn tại.</div>
                    }
                    else if (canApplyRecommendations)
                    {
                        <form asp-action="ApplyCareRecommendations" asp-route-id="@Model.Id" method="post"
                              onsubmit="return confirm('Áp dụng cả ba chu kỳ AI khuyến nghị cho cây này?');">
                            <button type="submit" class="btn btn-success w-100">
                                @(Model.CareRecommendationsAppliedAt.HasValue ? "Áp dụng lại lịch khuyến nghị" : "Chấp thuận và tạo lịch nhắc")
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">Dữ liệu khuyến nghị không hợp lệ nên không thể áp dụng tự động.</div>
                    }
                </div>
            </div>
        }

        @if (result.NeedsMoreInfo || !string.IsNullOrWhiteSpace(result.FollowUpQuestion))
        {
            <div class="alert alert-warning">
                <strong>AI cần thêm thông tin.</strong>
                @if (!string.IsNullOrWhiteSpace(result.FollowUpQuestion))
                {
                    <span>@result.FollowUpQuestion</span>
                }
            </div>
        }

        @if (warnings.Count > 0)
        {
            <div class="expert-warning mb-3">
                <strong>Lưu ý an toàn</strong>
                <ul class="mb-0 mt-2">
                    @foreach (var item in warnings) { <li>@item</li> }
                </ul>
            </div>
        }

        <p class="expert-privacy-note">Kết quả do AI tạo từ ảnh và thông tin bạn cung cấp, chỉ mang tính tham khảo.</p>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" asp-route-plantId="@Model.PlantId" class="btn btn-success">Đặt câu hỏi mới</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Xóa phiên tư vấn và ảnh liên quan?');">
                <button type="submit" class="btn btn-outline-danger">Xóa phiên này</button>
            </form>
        </div>
    </div>
</div>
