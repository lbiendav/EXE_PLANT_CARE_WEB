@using Microsoft.AspNetCore.Http
@inject IConfiguration Configuration
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentRole = Context.Session.GetString("Role") ?? "";
    var isPrivilegedAdmin = currentRole.Equals("admin", StringComparison.OrdinalIgnoreCase) || currentRole.Equals("super_admin", StringComparison.OrdinalIgnoreCase);
    var isContentAdmin = currentRole.Equals("content_admin", StringComparison.OrdinalIgnoreCase);
    var isRevenueAdmin = new[] { "finance", "support" }.Contains(currentRole, StringComparer.OrdinalIgnoreCase);
    var gaMeasurementId = Configuration["GoogleAnalytics:MeasurementId"]?.Trim() ?? "";
    var gaEnabled = System.Text.RegularExpressions.Regex.IsMatch(gaMeasurementId, "^G-[A-Z0-9]+$");
}

<!DOCTYPE html>

<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HomePlant</title>
    @if (gaEnabled)
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@gaMeasurementId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '@gaMeasurementId', { 'allow_google_signals': false, 'allow_ad_personalization_signals': false });
        </script>
    }
    <link rel="icon" type="image/png" sizes="64x64" href="~/images/brand/homeplant-favicon.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="~/images/brand/homeplant-icon-192.png" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/HomePlant.styles.css"
          asp-append-version="true" />
</head>

<body>

    <div class="grain"></div>

    <header>

        <nav class="navbar navbar-expand-xl custom-navbar" aria-label="Điều hướng chính">

            <div class="container-fluid nav-container">

                <a class="navbar-brand brand-lockup"
                   asp-controller="Home"
                   asp-action="Index"
                   aria-label="HomePlant — Vườn trong nhà">
                    <img class="brand-lockup__mark" src="~/images/brand/homeplant-mark.png" alt="" />
                    <span class="brand-lockup__copy">
                        <strong>HomePlant</strong>
                        <small><i></i>Vườn trong nhà<i></i></small>
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent"
                        aria-controls="navbarContent"
                        aria-expanded="false"
                        aria-label="Mở menu điều hướng">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="navbarContent">

                    <ul class="navbar-nav primary-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active" : "")"
                               asp-controller="Home"
                               asp-action="Index">
                                Khám phá
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Library" ? "active" : "")"
                               asp-controller="Library"
                               asp-action="Index">
                                Thư viện cây
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Article" ? "active" : "")"
                               asp-controller="Article"
                               asp-action="Index">
                                Cẩm nang
                            </a>
                        </li>

                        <li class="nav-item"><a class="nav-link @(currentController == "Community" ? "active" : "")" asp-controller="Community" asp-action="Index">Cộng đồng</a></li>
                        <li class="nav-item"><a class="nav-link @(currentController == "Plans" ? "active" : "")" asp-controller="Plans" asp-action="Index">Gói đăng ký</a></li>

                        @if (Context.Session.GetString("Email") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Plant" ? "active" : "")"
                                   asp-controller="Plant"
                                   asp-action="Index">
                                    Vườn của tôi
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Expert" ? "active" : "")"
                                   asp-controller="Expert"
                                   asp-action="Index">
                                    Chuyên gia
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link notification-nav-link @(currentController == "Notifications" ? "active" : "")"
                                   asp-controller="Notifications"
                                   asp-action="Index"
                                   data-notification-endpoint="@Url.Action("UnreadCount", "Notifications")">
                                    Nhắc việc
                                    <span class="notification-count d-none" aria-label="0 thông báo chưa đọc">0</span>
                                </a>
                            </li>

                            @if (isPrivilegedAdmin)
                            {
                                <li class="nav-item"><a class="nav-link @(currentController is "Admin" or "Revenue" ? "active" : "")" asp-controller="Admin" asp-action="Dashboard">Quản trị</a></li>
                            }
                            else if (isContentAdmin)
                            {
                                <li class="nav-item"><a class="nav-link @(currentController == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="SamplePlants">Quản trị</a></li>
                            }
                            else if (isRevenueAdmin)
                            {
                                <li class="nav-item"><a class="nav-link @(currentController == "Revenue" ? "active" : "")" asp-controller="Revenue" asp-action="Index">Quản trị</a></li>
                            }
                        }

                    </ul>

                    <ul class="navbar-nav account-nav align-items-xl-center">

                        @if (Context.Session.GetString("Email") == null)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Đăng nhập
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-success btn-sm ms-lg-3"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Đăng ký
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown user-menu">
                                <button class="user-menu-toggle dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="user-menu-avatar" aria-hidden="true">@(Context.Session.GetString("Email")?[0].ToString().ToUpperInvariant())</span>
                                    <span class="user-menu-copy">
                                        <small>Tài khoản</small>
                                        <strong>@Context.Session.GetString("Email")</strong>
                                    </span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">Hồ sơ cá nhân</a></li>
                                    <li><a class="dropdown-item @(currentController is "Subscription" or "Checkout" ? "active" : "")" asp-controller="Subscription" asp-action="Index">Gói của tôi</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button class="dropdown-item logout-item" type="submit">Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <div class="container mt-5 main-wrap">

        @if (TempData["Success"] is string successMessage)
        {
            <div class="alert alert-success" role="status">@successMessage</div>
        }

        @if (TempData["Warning"] is string warningMessage)
        {
            <div class="alert alert-warning" role="alert">@warningMessage</div>
        }

        <main role="main">

            @RenderBody()

        </main>

    </div>

    <footer class="footer-custom">

        <div class="container d-flex flex-wrap justify-content-between align-items-baseline gap-3">

            <a class="brand-lockup brand-lockup--footer" asp-controller="Home" asp-action="Index" aria-label="HomePlant — Vườn trong nhà">
                <img class="brand-lockup__mark" src="~/images/brand/homeplant-mark.png" alt="" />
                <span class="brand-lockup__copy">
                    <strong>HomePlant</strong>
                    <small><i></i>Vườn trong nhà<i></i></small>
                </span>
            </a>

            <span class="foot-mid">
                Chăm cây <em>trong nhà</em>, có nhịp có mùa.
            </span>

            <span class="foot-right">
                © 2026 HomePlant
            </span>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
