<!-- ═══════════════════════════════════════════════════════════════
     HOW IT WORKS — 4 BƯỚC BẮT ĐẦU CHỈ TRONG 2 PHÚT (HOMEPLANT)
     ═══════════════════════════════════════════════════════════════ -->
<section class="how-it-works-section" aria-labelledby="howItWorksHeading">

    <!-- Section Header -->
    <div class="steps-kicker-pill">
        <span aria-hidden="true">⏱</span>
        <span>Đơn giản &amp; Nhanh chóng</span>
    </div>

    <h2 id="howItWorksHeading" class="steps-heading">
        Bắt đầu chỉ trong <em>2 phút</em>
    </h2>

    <p class="steps-subtitle">
        Không cần phức tạp, chỉ cần vài bước đơn giản để bắt đầu hành trình chăm sóc khu vườn của bạn
    </p>

    <!-- 4 Steps Timeline -->
    <div class="steps-timeline-wrap">
        <!-- Connecting Line behind icons (Desktop) -->
        <div class="steps-connector-line" aria-hidden="true"></div>

        <div class="row g-4 justify-content-center">

            <!-- Step 1: Đăng ký tài khoản -->
            <div class="col-lg-3 col-sm-6">
                <a asp-controller="Account" asp-action="Register" class="step-item">
                    <div class="step-icon-wrapper">
                        <div class="step-icon-box">
                            <!-- User profile icon -->
                            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                <circle cx="9" cy="7" r="4" />
                                <path d="M19 8v6" />
                                <path d="M22 11h-6" />
                            </svg>
                        </div>
                        <span class="step-badge" aria-label="Bước 1">1</span>
                    </div>

                    <h3 class="step-title">Đăng ký tài khoản</h3>
                    <p class="step-desc">Tạo tài khoản miễn phí chỉ trong 30 giây</p>
                </a>
            </div>

            <!-- Step 2: Thêm cây vào vườn -->
            <div class="col-lg-3 col-sm-6">
                <a asp-controller="Plant" asp-action="Index" class="step-item">
                    <div class="step-icon-wrapper">
                        <div class="step-icon-box">
                            <!-- Plant pot icon -->
                            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 10a6 6 0 0 0-6-6H4v2a6 6 0 0 0 6 6h2z" />
                                <path d="M12 10a6 6 0 0 1 6-6h2v2a6 6 0 0 1-6 6h-2z" />
                                <path d="M12 10v12" />
                                <path d="M5 14h14l-1.5 7h-11z" />
                            </svg>
                        </div>
                        <span class="step-badge" aria-label="Bước 2">2</span>
                    </div>

                    <h3 class="step-title">Thêm cây vào vườn</h3>
                    <p class="step-desc">Nhập thông tin và ảnh chậu cây của bạn</p>
                </a>
            </div>

            <!-- Step 3: Khám phá tính năng -->
            <div class="col-lg-3 col-sm-6">
                <a asp-controller="Library" asp-action="Index" class="step-item">
                    <div class="step-icon-wrapper">
                        <div class="step-icon-box">
                            <!-- Sparkles / AI discovery icon -->
                            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z" />
                                <path d="M5 3v4" />
                                <path d="M3 5h4" />
                                <path d="M19 17v4" />
                                <path d="M17 19h4" />
                            </svg>
                        </div>
                        <span class="step-badge" aria-label="Bước 3">3</span>
                    </div>

                    <h3 class="step-title">Khám phá tính năng</h3>
                    <p class="step-desc">Sử dụng AI, chẩn đoán bệnh, kết nối chuyên gia</p>
                </a>
            </div>

            <!-- Step 4: Chăm sóc khu vườn -->
            <div class="col-lg-3 col-sm-6">
                <a asp-controller="Notifications" asp-action="Index" class="step-item">
                    <div class="step-icon-wrapper">
                        <div class="step-icon-box">
                            <!-- Heart / Care icon -->
                            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                            </svg>
                        </div>
                        <span class="step-badge" aria-label="Bước 4">4</span>
                    </div>

                    <h3 class="step-title">Chăm sóc khu vườn</h3>
                    <p class="step-desc">Quản lý sức khỏe, lịch tưới và niềm vui ngắm cây</p>
                </a>
            </div>

        </div>
    </div>

</section>
