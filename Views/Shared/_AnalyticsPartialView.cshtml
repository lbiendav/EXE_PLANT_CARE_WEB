@model HomePlant.ViewModels.GoogleAnalyticsOverviewVM

<section class="mt-4 mb-4" aria-labelledby="ga4-analytics-title">
    <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
        <div>
            <span class="kicker">Google Analytics 4 & SEO</span>
            <h2 id="ga4-analytics-title" class="h3 mb-0">Thống kê lưu lượng, hành vi & hiệu suất website</h2>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge @(Model.Available ? "bg-success" : "bg-secondary")">@(Model.Available ? "Đang đồng bộ GA4" : "Chưa có dữ liệu")</span>
            <a href="https://analytics.google.com" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-success">
                Mở GA4 Console &rarr;
            </a>
        </div>
    </div>

    @if (!Model.Configured)
    {
        <div class="status-panel">
            <p class="text-muted mb-2">
                Chưa bật hoặc chưa cấu hình đầy đủ Google Analytics.
            </p>
            <p class="small text-muted mb-0">
                Để kích hoạt: cấu hình <code>GoogleAnalytics:MeasurementId</code> (mã dạng <code>G-XXXXXXXXXX</code> để thu thập truy cập) và <code>GoogleAnalytics:PropertyId</code> (mã số Property để hiển thị báo cáo tự động tại đây).
            </p>
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-warning">@Model.Error</div>
    }
    else
    {
        <!-- 5 Cards Chỉ số Tổng Quan (Bao gồm Bounce Rate chuẩn SEO) -->
        <div class="row g-3 mb-4">
            <div class="col-xl col-md-4 col-sm-6">
                <div class="status-panel analytics-metric h-100">
                    <strong>@Model.ActiveUsers30Days.ToString("N0")</strong>
                    <span>Người truy cập (30 ngày)</span>
                </div>
            </div>
            <div class="col-xl col-md-4 col-sm-6">
                <div class="status-panel analytics-metric h-100">
                    <strong>@Model.Sessions30Days.ToString("N0")</strong>
                    <span>Phiên hoạt động</span>
                </div>
            </div>
            <div class="col-xl col-md-4 col-sm-6">
                <div class="status-panel analytics-metric h-100">
                    <strong>@Model.PageViews30Days.ToString("N0")</strong>
                    <span>Lượt xem trang</span>
                </div>
            </div>
            <div class="col-xl col-md-6 col-sm-6">
                <div class="status-panel analytics-metric h-100">
                    <strong>@Model.FormattedAverageEngagement</strong>
                    <span>Thời gian tương tác TB</span>
                </div>
            </div>
            <div class="col-xl col-md-6 col-sm-6">
                <div class="status-panel analytics-metric h-100">
                    <strong>@Model.FormattedBounceRate</strong>
                    <span>Tỷ lệ thoát (Bounce Rate)</span>
                </div>
            </div>
        </div>

        <!-- Row 2: Lượt truy cập mỗi ngày (Trái) & Nguồn + Thiết bị (Phải) -->
        <div class="row g-4 mb-4">
            <div class="col-xl-7">
                <div class="status-panel h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <h3 class="h6 text-uppercase mb-0">Thành viên truy cập mỗi ngày (30 ngày qua)</h3>
                        <small class="text-muted">User (Thành viên có tài khoản)</small>
                    </div>

                    <div class="mb-3 p-3 rounded" style="background: rgba(208, 234, 144, 0.08); border: 1px solid rgba(208, 234, 144, 0.25);">
                        <span class="small text-muted d-block mb-1 text-uppercase fw-semibold" style="letter-spacing: .08em;">Trung bình 1 ngày (trong 30 ngày qua)</span>
                        <div class="d-flex flex-wrap gap-4 align-items-baseline">
                            <div><strong class="fs-5 text-success">@Model.AverageDailyUsers30Days.ToString("N1")</strong> <small class="text-muted">thành viên / ngày</small></div>
                            @{
                                var avgNew = Model.DailyTrends.Count > 0 ? (double)Model.DailyTrends.Sum(d => d.NewUsers) / Model.DailyTrends.Count : 0;
                                var avgRet = Model.DailyTrends.Count > 0 ? (double)Model.DailyTrends.Sum(d => d.ReturningUsers) / Model.DailyTrends.Count : 0;
                            }
                            <div><strong class="fs-5 text-success">@avgNew.ToString("N1")</strong> <small class="text-muted">user mới / ngày</small></div>
                            <div><strong class="fs-5 text-info">@avgRet.ToString("N1")</strong> <small class="text-muted">user cũ / ngày</small></div>
                        </div>
                    </div>

                    @if (Model.DailyTrends.Count == 0)
                    {
                        <p class="text-muted small mb-0">Chưa có đủ dữ liệu theo ngày trong khoảng thời gian này.</p>
                    }
                    else
                    {
                        var maxDailyUsers = Math.Max(1, Model.DailyTrends.Max(d => d.ActiveUsers));
                        <style>
                            .daily-trends-scroll-wrap::-webkit-scrollbar {
                                width: 6px;
                            }
                            .daily-trends-scroll-wrap::-webkit-scrollbar-track {
                                background: rgba(255, 255, 255, 0.02);
                                border-radius: 4px;
                            }
                            .daily-trends-scroll-wrap::-webkit-scrollbar-thumb {
                                background: rgba(208, 234, 144, 0.25);
                                border-radius: 4px;
                            }
                            .daily-trends-scroll-wrap::-webkit-scrollbar-thumb:hover {
                                background: rgba(208, 234, 144, 0.5);
                            }
                            .daily-trends-sticky-th {
                                position: sticky;
                                top: 0;
                                background-color: var(--bg2, #27392c) !important;
                                z-index: 2;
                                box-shadow: inset 0 -1px 0 rgba(208, 234, 144, 0.2);
                            }
                        </style>
                        <div class="table-responsive daily-trends-scroll-wrap" style="max-height: 440px; overflow-y: auto; scrollbar-width: thin; scrollbar-color: rgba(208, 234, 144, 0.3) transparent;">
                            <table class="table table-sm align-middle mb-0" id="dailyTrendsTable">
                                <thead>
                                    <tr>
                                        <th class="daily-trends-sticky-th" style="width: 80px; cursor: pointer;" onclick="toggleDailyTrendsSort()" title="Nhấn để đổi chiều xem ngày (Mới nhất / Cũ nhất)">Ngày <span id="sortDirectionIcon" class="text-success small">↓</span></th>
                                        <th class="daily-trends-sticky-th">Mật độ</th>
                                        <th class="daily-trends-sticky-th text-end" style="width: 60px;" title="Tổng số thành viên có tài khoản tương tác trong ngày">Tổng User</th>
                                        <th class="daily-trends-sticky-th text-end text-success" style="width: 55px;" title="Thành viên tạo tài khoản mới thành công">Mới</th>
                                        <th class="daily-trends-sticky-th text-end text-info" style="width: 55px;" title="Thành viên cũ quay lại đăng nhập">Cũ</th>
                                        <th class="daily-trends-sticky-th text-end text-warning" style="width: 60px;" title="Lượt xem trang của thành viên trong ngày">Trang</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var day in Model.DailyTrends)
                                    {
                                        var pct = Math.Round((double)day.ActiveUsers / maxDailyUsers * 100);
                                        <tr>
                                            <td class="text-nowrap"><strong>@day.DisplayDate</strong></td>
                                            <td>
                                                <div class="progress" style="height: 6px; background-color: var(--hair-soft);">
                                                    <div class="progress-bar" role="progressbar" style="width: @(pct)%; background-color: var(--green);" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                            </td>
                                            <td class="text-end font-monospace">
                                                @if (day.ActiveUsers > 0)
                                                {
                                                    <button type="button" class="btn btn-link p-0 text-decoration-none fw-semibold text-light" onclick="openDailyUsersModal('@day.DateKey', '@day.DisplayDate', 'all')" title="Xem chi tiết người dùng ngày @day.DisplayDate">@day.ActiveUsers</button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">0</span>
                                                }
                                            </td>
                                            <td class="text-end font-monospace">
                                                @if (day.NewUsers > 0)
                                                {
                                                    <button type="button" class="btn btn-link p-0 text-decoration-none fw-bold text-success text-decoration-underline" onclick="openDailyUsersModal('@day.DateKey', '@day.DisplayDate', 'new')" title="Xem chi tiết User MỚI ngày @day.DisplayDate">@day.NewUsers</button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">0</span>
                                                }
                                            </td>
                                            <td class="text-end font-monospace">
                                                @if (day.ReturningUsers > 0)
                                                {
                                                    <button type="button" class="btn btn-link p-0 text-decoration-none fw-bold text-info text-decoration-underline" onclick="openDailyUsersModal('@day.DateKey', '@day.DisplayDate', 'returning')" title="Xem chi tiết User CŨ ngày @day.DisplayDate">@day.ReturningUsers</button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">0</span>
                                                }
                                            </td>
                                            <td class="text-end font-monospace">
                                                @if (day.PageViews > 0)
                                                {
                                                    <button type="button" class="btn btn-link p-0 text-decoration-none fw-bold text-warning text-decoration-underline" onclick="openDailyUsersModal('@day.DateKey', '@day.DisplayDate', 'pages')" title="Xem chi tiết các trang đã xem ngày @day.DisplayDate">@day.PageViews</button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">0</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Cột phải: Nguồn truy cập & Phân bố Thiết bị + Địa lý -->
            <div class="col-xl-5">
                <div class="d-flex flex-column gap-3 h-100">
                    <div class="status-panel">
                        <h3 class="h6 text-uppercase mb-3">Nguồn truy cập (Traffic Sources)</h3>
                        @if (Model.TrafficSources.Count == 0)
                        {
                            <p class="text-muted small mb-0">Chưa ghi nhận nguồn traffic.</p>
                        }
                        else
                        {
                            var totalSessionsFromSources = Math.Max(1, Model.TrafficSources.Sum(s => s.Value));
                            @foreach (var source in Model.TrafficSources)
                            {
                                var pct = Math.Round((double)source.Value / totalSessionsFromSources * 100);
                                <div class="analytics-row align-items-center">
                                    <div class="text-truncate me-2" style="max-width: 60%;">
                                        <span class="d-block text-truncate">@source.Label</span>
                                        <div class="progress mt-1" style="height: 3px; background-color: var(--hair-soft);">
                                            <div class="progress-bar bg-success" style="width: @(pct)%;"></div>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <strong>@source.Value.ToString("N0") phiên</strong>
                                        <small class="text-muted ps-1">(@pct%)</small>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <!-- SEO Section: Thiết bị & Quốc gia -->
                    <div class="status-panel">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <h4 class="h6 text-uppercase mb-2">Thiết bị (Devices)</h4>
                                @if (Model.DeviceBreakdown.Count == 0)
                                {
                                    <p class="text-muted small mb-0">Chưa có dữ liệu thiết bị.</p>
                                }
                                else
                                {
                                    @foreach (var dev in Model.DeviceBreakdown)
                                    {
                                        <div class="d-flex justify-content-between small py-1 border-bottom border-secondary-subtle">
                                            <span class="text-capitalize">@dev.Label</span>
                                            <strong class="font-monospace text-success">@dev.Value.ToString("N0")</strong>
                                        </div>
                                    }
                                }
                            </div>
                            <div class="col-sm-6">
                                <h4 class="h6 text-uppercase mb-2">Quốc gia (Geo)</h4>
                                @if (Model.Countries.Count == 0)
                                {
                                    <p class="text-muted small mb-0">Chưa có dữ liệu quốc gia.</p>
                                }
                                else
                                {
                                    @foreach (var c in Model.Countries)
                                    {
                                        <div class="d-flex justify-content-between small py-1 border-bottom border-secondary-subtle">
                                            <span class="text-truncate" style="max-width: 110px;">@c.Label</span>
                                            <strong class="font-monospace text-info">@c.Value.ToString("N0")</strong>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <div class="status-panel p-3 rounded" style="background: rgba(46, 125, 50, 0.08); border: 1px dashed var(--green);">
                        <h4 class="h6 mb-1 text-success">Theo dõi hành vi của TỪNG USER cụ thể</h4>
                        <p class="small text-muted mb-2">
                            Website tự động lưu nhật ký hoạt động trực tiếp vào cơ sở dữ liệu và đồng bộ User-ID lên GA4.
                        </p>
                        <a href="/Admin/Users" class="btn btn-sm btn-outline-success">Xem nhật ký & hoạt động từng User &rarr;</a>
                    </div>
                </div>
            </div>
        </div>

    }
</section>

<!-- Modal xem chi tiết người dùng mới / cũ theo ngày -->
<div class="modal fade" id="dailyUsersModal" tabindex="-1" aria-labelledby="dailyUsersModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content" style="background-color: var(--bg-surface, #15221c); color: var(--ink, #e0ede4); border: 1px solid var(--hair-soft, rgba(208, 234, 144, 0.2));">
            <div class="modal-header border-bottom border-secondary-subtle">
                <div>
                    <h5 class="modal-title h5 mb-1" id="dailyUsersModalTitle">Chi tiết người dùng</h5>
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-light active" id="btnTabAll" onclick="filterDailyUsers('all')">
                                Tất cả (<span id="modalCountAll">0</span>)
                            </button>
                            <button type="button" class="btn btn-outline-success" id="btnTabNew" onclick="filterDailyUsers('new')">
                                User Mới (<span id="modalCountNew">0</span>)
                            </button>
                            <button type="button" class="btn btn-outline-info" id="btnTabReturning" onclick="filterDailyUsers('returning')">
                                User Cũ (<span id="modalCountReturning">0</span>)
                            </button>
                            <button type="button" class="btn btn-outline-warning" id="btnTabPages" onclick="filterDailyUsers('pages')">
                                Trang (<span id="modalCountPages">0</span>)
                            </button>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-3">
                <div id="modalSummaryInfo" class="p-2 mb-3 rounded d-flex justify-content-between align-items-center small d-none" style="background: rgba(208, 234, 144, 0.08); border: 1px solid rgba(208, 234, 144, 0.2);">
                    <div>
                        <span class="text-success fw-semibold">Tổng ghi nhận:</span>
                        <span id="modalGa4Summary" class="text-light">--</span>
                    </div>
                    <small class="text-muted" id="modalDbSummary">100% tài khoản thành viên thật</small>
                </div>
                <div id="dailyUsersLoading" class="text-center py-5">
                    <div class="spinner-border text-success" role="status"></div>
                    <p class="text-muted mt-2 mb-0">Đang tải danh sách thành viên và các trang đã xem...</p>
                </div>
                <div id="dailyUsersEmpty" class="text-center py-5 d-none">
                    <div class="text-muted mb-2">
                        <svg width="42" height="42" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    </div>
                    <h6 class="text-muted mb-1" id="dailyUsersEmptyMsg">Không có dữ liệu thành viên trong mục này.</h6>
                    <small class="text-muted d-block">Chỉ tính các tài khoản thành viên thật đã đăng ký hoặc đăng nhập trên website HomePlant.</small>
                </div>
                <div id="dailyUsersContainer" class="d-flex flex-column gap-3 d-none"></div>
            </div>
            <div class="modal-footer border-top border-secondary-subtle">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script>
if (typeof window.dailyUsersInitialized === 'undefined') {
    window.dailyUsersInitialized = true;
    window.allDailyUsers = [];
    window.currentFilterType = 'all';
    window.dailyTrendsAscending = false;

    window.toggleDailyTrendsSort = function() {
        const tbody = document.querySelector('#dailyTrendsTable tbody');
        if (!tbody) return;
        const rows = Array.from(tbody.querySelectorAll('tr'));
        rows.reverse();
        rows.forEach(r => tbody.appendChild(r));
        window.dailyTrendsAscending = !window.dailyTrendsAscending;
        const icon = document.getElementById('sortDirectionIcon');
        if (icon) icon.innerText = window.dailyTrendsAscending ? '↑' : '↓';
    };

    window.openDailyUsersModal = function(dateKey, displayDate, type) {
        window.currentFilterType = type || 'all';
        const titleEl = document.getElementById('dailyUsersModalTitle');
        if (titleEl) {
            titleEl.innerHTML = 'Thành viên truy cập ngày <span class="text-success font-monospace">' + displayDate + '</span>';
        }
        
        const loading = document.getElementById('dailyUsersLoading');
        const empty = document.getElementById('dailyUsersEmpty');
        const container = document.getElementById('dailyUsersContainer');
        const summaryInfo = document.getElementById('modalSummaryInfo');

        if (loading) loading.classList.remove('d-none');
        if (empty) empty.classList.add('d-none');
        if (summaryInfo) summaryInfo.classList.add('d-none');
        if (container) {
            container.classList.add('d-none');
            container.innerHTML = '';
        }

        const modalEl = document.getElementById('dailyUsersModal');
        if (modalEl) {
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }

        fetch('/Admin/DailyUsers?date=' + encodeURIComponent(dateKey) + '&type=all')
            .then(res => res.json())
            .then(data => {
                if (loading) loading.classList.add('d-none');
                window.allDailyUsers = (data && data.users) ? data.users : [];

                const countNew = window.allDailyUsers.filter(u => u.isNew).length;
                const countRet = window.allDailyUsers.filter(u => !u.isNew).length;
                const countPages = window.allDailyUsers.reduce((sum, u) => {
                    const featVisits = (u.pageSummaries || []).reduce((pSum, p) => pSum + (p.visitCount || 1), 0);
                    return sum + featVisits;
                }, 0);

                const countAllEl = document.getElementById('modalCountAll');
                const countNewEl = document.getElementById('modalCountNew');
                const countRetEl = document.getElementById('modalCountReturning');
                const countPagesEl = document.getElementById('modalCountPages');

                if (countAllEl) countAllEl.innerText = window.allDailyUsers.length;
                if (countNewEl) countNewEl.innerText = countNew;
                if (countRetEl) countRetEl.innerText = countRet;
                if (countPagesEl) countPagesEl.innerText = countPages;

                if (summaryInfo && window.allDailyUsers.length > 0) {
                    summaryInfo.classList.remove('d-none');
                    const ga4El = document.getElementById('modalGa4Summary');
                    const dbEl = document.getElementById('modalDbSummary');
                    if (ga4El) ga4El.innerText = window.allDailyUsers.length + ' thành viên (' + countNew + ' mới, ' + countRet + ' cũ, ' + countPages + ' lượt xem 7 trang tính năng)';
                    if (dbEl) dbEl.innerText = '100% tài khoản thành viên thật trong hệ thống';
                }

                window.filterDailyUsers(window.currentFilterType);
            })
            .catch(err => {
                if (loading) loading.classList.add('d-none');
                if (empty) empty.classList.remove('d-none');
                const emptyMsg = document.getElementById('dailyUsersEmptyMsg');
                if (emptyMsg) emptyMsg.innerText = 'Không thể tải dữ liệu: ' + err.message;
            });
    };

    const formatSecHelper = function(sec) {
        if (!sec || sec <= 0) return '0s';
        if (sec < 60) return sec + 's';
        const m = Math.floor(sec / 60);
        const s = sec % 60;
        return s > 0 ? (m + 'm ' + s + 's') : (m + 'm');
    };

    const getCategoryStyle = function(category) {
        switch (category) {
            case 'Thư viện cây':
                return { bg: 'rgba(34, 197, 94, 0.16)', text: '#86efac', border: 'rgba(74, 222, 128, 0.45)' };
            case 'Cẩm nang':
                return { bg: 'rgba(56, 189, 248, 0.16)', text: '#7dd3fc', border: 'rgba(56, 189, 248, 0.45)' };
            case 'Cộng đồng':
                return { bg: 'rgba(168, 85, 247, 0.16)', text: '#d8b4fe', border: 'rgba(192, 132, 252, 0.45)' };
            case 'Gói đăng ký':
                return { bg: 'rgba(234, 179, 8, 0.16)', text: '#fde047', border: 'rgba(250, 204, 21, 0.45)' };
            case 'Vườn của tôi':
                return { bg: 'rgba(16, 185, 129, 0.16)', text: '#6ee7b7', border: 'rgba(52, 211, 153, 0.45)' };
            case 'Chuyên gia':
                return { bg: 'rgba(249, 115, 22, 0.16)', text: '#fdba74', border: 'rgba(251, 146, 60, 0.45)' };
            case 'Nhắc việc':
                return { bg: 'rgba(244, 63, 94, 0.16)', text: '#fda4af', border: 'rgba(251, 113, 133, 0.45)' };
            default:
                return { bg: 'rgba(255, 255, 255, 0.08)', text: '#f1f5f9', border: 'rgba(255, 255, 255, 0.2)' };
        }
    };

    const renderBadges = function(isNew) {
        const isNewHtml = isNew 
            ? '<span class="badge" style="background: rgba(34, 197, 94, 0.2); color: #4ade80; border: 1px solid rgba(74, 222, 128, 0.5); font-weight: 600; font-size: 0.75rem; padding: 3px 8px;">User Mới</span>' 
            : '<span class="badge" style="background: rgba(56, 189, 248, 0.2); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.5); font-weight: 600; font-size: 0.75rem; padding: 3px 8px;">User Cũ</span>';
        const memberHtml = '<span class="badge" style="background: rgba(168, 85, 247, 0.2); color: #c084fc; border: 1px solid rgba(192, 132, 252, 0.4); font-weight: 600; font-size: 0.75rem; padding: 3px 8px;">Thành viên</span>';
        return { isNewHtml, memberHtml };
    };

    window.filterDailyUsers = function(type) {
        window.currentFilterType = type;
        const tabAll = document.getElementById('btnTabAll');
        const tabNew = document.getElementById('btnTabNew');
        const tabRet = document.getElementById('btnTabReturning');
        const tabPages = document.getElementById('btnTabPages');

        if (tabAll) tabAll.classList.toggle('active', type === 'all');
        if (tabNew) tabNew.classList.toggle('active', type === 'new');
        if (tabRet) tabRet.classList.toggle('active', type === 'returning');
        if (tabPages) tabPages.classList.toggle('active', type === 'pages');

        const empty = document.getElementById('dailyUsersEmpty');
        const container = document.getElementById('dailyUsersContainer');
        if (!container) return;
        container.innerHTML = '';

        let filtered = window.allDailyUsers || [];
        if (type === 'new') filtered = filtered.filter(u => u.isNew);
        if (type === 'returning') filtered = filtered.filter(u => !u.isNew);
        if (type === 'pages') {
            filtered = filtered.filter(u => u.pageSummaries && u.pageSummaries.length > 0);
        }

        if (filtered.length === 0) {
            if (empty) empty.classList.remove('d-none');
            container.classList.add('d-none');
            const emptyMsg = document.getElementById('dailyUsersEmptyMsg');
            if (emptyMsg) {
                if (type === 'returning' && (window.allDailyUsers || []).some(u => u.isNew)) {
                    const countNew = window.allDailyUsers.filter(u => u.isNew).length;
                    emptyMsg.innerHTML = 'Ngày này chưa có User cũ đăng nhập.<br><button type="button" class="btn btn-sm btn-outline-success mt-2" onclick="window.filterDailyUsers(\'new\')">Xem ' + countNew + ' User Mới</button>';
                } else if (type === 'new' && (window.allDailyUsers || []).some(u => !u.isNew)) {
                    const countRet = window.allDailyUsers.filter(u => !u.isNew).length;
                    emptyMsg.innerHTML = 'Ngày này chưa có User mới đăng ký.<br><button type="button" class="btn btn-sm btn-outline-info mt-2" onclick="window.filterDailyUsers(\'returning\')">Xem ' + countRet + ' User Cũ</button>';
                } else if (type === 'pages') {
                    emptyMsg.innerHTML = '<span class="fw-semibold">Ngày này chưa có thành viên nào truy cập 7 trang tính năng:</span><br><div class="mt-2 text-success small font-monospace">Thư viện cây · Cẩm nang · Cộng đồng · Gói đăng ký · Vườn của tôi · Chuyên gia · Nhắc việc</div>';
                } else {
                    emptyMsg.innerText = 'Ngày này không có tài khoản thành viên nào đăng nhập / đăng ký.';
                }
            }
            return;
        }

        if (empty) empty.classList.add('d-none');
        container.classList.remove('d-none');

        if (type === 'pages') {
            // Aggregate totals across all users for the 7 navbar features
            const navCategories = [
                { name: 'Thư viện cây', icon: '🌿' },
                { name: 'Cẩm nang', icon: '📖' },
                { name: 'Cộng đồng', icon: '👥' },
                { name: 'Gói đăng ký', icon: '⭐' },
                { name: 'Vườn của tôi', icon: '🌱' },
                { name: 'Chuyên gia', icon: '👨‍🌾' },
                { name: 'Nhắc việc', icon: '⏰' }
            ];

            const catStats = {};
            navCategories.forEach(c => {
                catStats[c.name] = { visits: 0, users: new Set(), totalDuration: 0 };
            });

            (window.allDailyUsers || []).forEach(u => {
                (u.pageSummaries || []).forEach(p => {
                    if (p.category && catStats.hasOwnProperty(p.category)) {
                        catStats[p.category].visits += (p.visitCount || 1);
                        catStats[p.category].users.add(u.uid);
                        catStats[p.category].totalDuration += (p.totalDurationSeconds || 0);
                    }
                });
            });

            // Summary banner for the 7 feature pages
            const summaryBanner = document.createElement('div');
            summaryBanner.className = 'p-3 rounded border mb-3';
            summaryBanner.style.background = 'rgba(255, 255, 255, 0.02)';
            summaryBanner.style.borderColor = 'rgba(208, 234, 144, 0.25)';

            let pillsHtml = navCategories.map(c => {
                const stat = catStats[c.name];
                const hasVisits = stat.visits > 0;
                const cStyle = getCategoryStyle(c.name);
                if (hasVisits) {
                    return `
                        <div class="d-flex align-items-center justify-content-between p-2 rounded" 
                             style="background: ${cStyle.bg}; border: 1px solid ${cStyle.border}; min-width: 155px; flex: 1 1 calc(25% - 8px);">
                            <div>
                                <span class="me-1" style="font-size: 1.05rem;">${c.icon}</span>
                                <strong style="color: #ffffff; font-size: 0.9rem;">${c.name}</strong>
                            </div>
                            <div class="text-end font-monospace small">
                                <strong style="color: ${cStyle.text}; font-size: 0.95rem;">${stat.visits} lượt</strong>
                                <small class="d-block" style="color: #fbbf24; font-size: 0.75rem;">⏱ ${formatSecHelper(stat.totalDuration)}</small>
                            </div>
                        </div>
                    `;
                } else {
                    return `
                        <div class="d-flex align-items-center justify-content-between p-2 rounded" 
                             style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); min-width: 155px; flex: 1 1 calc(25% - 8px); opacity: 0.5;">
                            <div>
                                <span class="me-1" style="font-size: 1.05rem;">${c.icon}</span>
                                <span style="color: #94a3b8; font-size: 0.88rem;">${c.name}</span>
                            </div>
                            <div class="text-end font-monospace small">
                                <span style="color: #64748b; font-size: 0.85rem;">0 lượt</span>
                            </div>
                        </div>
                    `;
                }
            }).join('');

            summaryBanner.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom border-secondary-subtle">
                    <span class="small text-uppercase fw-semibold" style="color: #4ade80; letter-spacing: .05em;">
                        Thống kê 7 trang tính năng chính được truy cập
                    </span>
                    <small style="color: #94a3b8;">Chỉ hiển thị khi có thành viên truy cập</small>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    ${pillsHtml}
                </div>
            `;
            container.appendChild(summaryBanner);

            // Render each user who visited feature pages
            filtered.forEach((u) => {
                const card = document.createElement('div');
                card.className = 'p-3 rounded border';
                card.style.background = 'rgba(255, 255, 255, 0.03)';
                card.style.borderColor = 'rgba(255, 193, 7, 0.25)';

                const badges = renderBadges(u.isNew);
                const avatarHtml = `<img src="${u.avatarUrl || ('https://i.pravatar.cc/150?u=' + encodeURIComponent(u.uid))}" class="rounded-circle flex-shrink-0" width="36" height="36" style="object-fit: cover; border: 1px solid rgba(208, 234, 144, 0.4);" alt="User" onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(u.fullName || 'User')}&background=1f3326&color=d0ea90';"/>`;

                const pages = (u.pageSummaries || []);
                const userFeatureSec = pages.reduce((acc, p) => acc + (p.totalDurationSeconds || 0), 0);
                const totalUserDuration = formatSecHelper(userFeatureSec);
                const totalUserViews = pages.reduce((acc, p) => acc + (p.visitCount || 0), 0);

                const tableRowsHtml = pages.map((p) => {
                    const timesStr = (p.visitTimes && p.visitTimes.length > 0)
                        ? `<div class="font-monospace mt-1" style="color: #94a3b8; font-size: 0.74rem;">Thời điểm: ${p.visitTimes.join(', ')}</div>`
                        : '';
                    const cStyle = getCategoryStyle(p.category);
                    const catBadge = p.category 
                        ? `<span class="badge me-1" style="background: ${cStyle.bg}; color: ${cStyle.text}; border: 1px solid ${cStyle.border}; font-size: 0.75rem; font-weight: 600; padding: 3px 8px;">${p.category}</span>`
                        : '';
                    return `
                        <tr>
                            <td class="align-middle py-2">
                                <div class="d-flex align-items-center gap-1 mb-1">
                                    ${catBadge}
                                    <strong style="color: #ffffff; font-size: 0.92rem;" class="text-truncate" style="max-width: 320px;" title="${p.title || p.path}">${p.title || p.path}</strong>
                                </div>
                                <code style="color: #86efac; background: rgba(0, 0, 0, 0.35); padding: 2px 6px; border-radius: 4px; font-size: 0.78rem;">${p.path}</code>
                                ${timesStr}
                            </td>
                            <td class="text-center align-middle py-2">
                                <span class="badge font-monospace" style="background: rgba(34, 197, 94, 0.2); color: #4ade80; border: 1px solid rgba(74, 222, 128, 0.45); font-size: 0.85rem; font-weight: 700; padding: 4px 10px;">
                                    ${p.visitCount} lần
                                </span>
                            </td>
                            <td class="text-end align-middle py-2 font-monospace">
                                <span class="badge font-monospace" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(251, 191, 36, 0.45); font-size: 0.85rem; font-weight: 700; padding: 4px 10px;">
                                    ⏱ ${p.formattedDuration || '0s'}
                                </span>
                            </td>
                        </tr>
                    `;
                }).join('');

                card.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2 pb-2 border-bottom border-secondary-subtle">
                        <div class="d-flex align-items-center gap-2">
                            ${avatarHtml}
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <strong style="color: #ffffff; font-size: 1rem;">${u.fullName}</strong>
                                    ${badges.isNewHtml}
                                    ${badges.memberHtml}
                                </div>
                                <small style="color: #94a3b8;">${u.email || u.uid}</small>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 font-monospace small">
                            <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(251, 191, 36, 0.4); font-size: 0.82rem; padding: 4px 8px;" title="Tổng thời gian ở lại các trang tính năng của User này">
                                ⏱ Tổng thời gian: ${totalUserDuration}
                            </span>
                            <span class="badge" style="background: rgba(255, 255, 255, 0.08); color: #e2e8f0; border: 1px solid rgba(255, 255, 255, 0.2); font-size: 0.82rem; padding: 4px 8px;">
                                ${pages.length} trang · ${totalUserViews} lượt truy cập
                            </span>
                        </div>
                    </div>
                    <div class="table-responsive mt-1">
                        <table class="table table-sm table-borderless align-middle mb-0" style="font-size: 0.85rem;">
                            <thead>
                                <tr style="color: #94a3b8; border-bottom: 1px solid rgba(255, 255, 255, 0.1); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em;">
                                    <th>Trang tính năng đã xem</th>
                                    <th class="text-center" style="width: 130px;">Số lần truy cập</th>
                                    <th class="text-end" style="width: 140px;">Thời gian ở lại</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${tableRowsHtml}
                            </tbody>
                        </table>
                    </div>
                `;
                container.appendChild(card);
            });
            return;
        }

        filtered.forEach((u) => {
            const card = document.createElement('div');
            card.className = 'p-3 rounded border';
            card.style.background = 'rgba(255, 255, 255, 0.03)';
            card.style.borderColor = 'rgba(208, 234, 144, 0.2)';

            const badges = renderBadges(u.isNew);

            let activitiesHtml = '';
            if (u.activities && u.activities.length > 0) {
                activitiesHtml = `
                    <div class="mt-3 pt-2 border-top border-secondary-subtle">
                        <small class="text-uppercase fw-semibold d-block mb-2" style="color: #94a3b8; letter-spacing: .05em; font-size: 0.75rem;">
                            Các trang đã xem trong phiên (${u.activities.length} lượt):
                        </small>
                        <div class="d-flex flex-column gap-2" style="max-height: 220px; overflow-y: auto;">
                            ${u.activities.map(a => `
                                <div class="d-flex align-items-baseline gap-2 small flex-wrap">
                                    <span class="font-monospace" style="color: #94a3b8; font-size: 0.8rem; min-width: 58px;">${a.time}</span>
                                    <span class="badge px-1" style="background: rgba(255, 255, 255, 0.08); color: #cbd5e1; border: 1px solid rgba(255, 255, 255, 0.15);">${a.action || 'Xem'}</span>
                                    <strong style="color: #4ade80;" class="text-truncate">${a.title}</strong>
                                    <code style="color: #94a3b8;">${a.path}</code>
                                    <span class="badge ms-auto font-monospace" style="background: rgba(245, 158, 11, 0.18); color: #fbbf24; border: 1px solid rgba(251, 191, 36, 0.35); font-size: 0.75rem;">⏱ ${a.formattedDuration || '20s'}</span>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `;
            } else {
                activitiesHtml = '<div class="mt-2 small fst-italic" style="color: #94a3b8;">Chưa có chi tiết trang cụ thể cho phiên này.</div>';
            }

            const avatarHtml = `<img src="${u.avatarUrl || ('https://i.pravatar.cc/150?u=' + encodeURIComponent(u.uid))}" class="rounded-circle flex-shrink-0" width="36" height="36" style="object-fit: cover; border: 1px solid rgba(208, 234, 144, 0.3);" alt="User" onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(u.fullName || 'User')}&background=1f3326&color=d0ea90';"/>`;

            card.innerHTML = `
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        ${avatarHtml}
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <strong style="color: #ffffff; font-size: 1rem;">${u.fullName}</strong>
                                ${badges.isNewHtml}
                                ${badges.memberHtml}
                            </div>
                            <small style="color: #94a3b8;">${u.email || u.uid}</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 font-monospace small">
                        <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(251, 191, 36, 0.4); font-size: 0.82rem; padding: 4px 8px;" title="Tổng thời gian tương tác">⏱ ${u.formattedTotalDuration || '0s'}</span>
                        <span class="badge" style="background: rgba(255, 255, 255, 0.08); color: #e2e8f0; border: 1px solid rgba(255, 255, 255, 0.2); font-size: 0.82rem; padding: 4px 8px;">${u.sessionCount || 1} phiên</span>
                        <span class="badge" style="background: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(74, 222, 128, 0.35); font-size: 0.82rem; padding: 4px 8px;">${u.pageViewCount || (u.activities ? u.activities.length : 1)} lượt xem</span>
                    </div>
                </div>
                ${activitiesHtml}
            `;
            container.appendChild(card);
        });
    };
}
</script>
