@model HomePlant.ViewModels.PlantSampleFormVM

@{
    var req = ViewBag.Request as HomePlant.Models.PlantSpeciesRequestModel;
    ViewData["Title"] = $"Xem xét giống cây: {req?.ProposedName}";
}

<a asp-action="SpeciesRequests" class="back-link">
    ← Danh sách yêu cầu giống cây
</a>

<div class="mb-4">
    <span class="kicker">Kiểm duyệt</span>
    <h1>Xem xét yêu cầu giống cây</h1>
</div>

@if (req != null)
{
    <div class="card mb-4 border-secondary">
        <div class="card-body p-4">
            <h6 class="kicker mb-3">Thông tin người gửi</h6>
            <div class="row g-3">
                <div class="col-md-3 col-sm-6">
                    <span class="text-muted d-block small">Giống cây đề xuất</span>
                    <strong class="fs-5">@req.ProposedName</strong>
                </div>
                <div class="col-md-3 col-sm-6">
                    <span class="text-muted d-block small">Cây trong vườn</span>
                    <strong>@req.PlantCustomName</strong>
                </div>
                <div class="col-md-3 col-sm-6">
                    <span class="text-muted d-block small">Người đề xuất</span>
                    <div>@req.UserDisplayName</div>
                    <small class="text-muted">@req.UserEmail</small>
                </div>
                <div class="col-md-3 col-sm-6">
                    <span class="text-muted d-block small">Trạng thái hiện tại</span>
                    <span class="badge bg-@req.StatusColorClass fs-6">@req.DisplayStatus</span>
                </div>
            </div>
        </div>
    </div>
}

<form method="post"
      asp-action="ProcessSpeciesRequest"
      asp-route-id="@req?.Id"
      enctype="multipart/form-data"
      style="max-width:720px;"
      id="reviewForm">

    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

    <div class="card mb-4">
        <div class="card-body p-4">
            <h6 class="kicker mb-3">Thông tin loài cây cho Thư viện</h6>

            <div class="mb-3">
                <label class="form-label" asp-for="Name">Tên thường gọi <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="Tên tiếng Việt chuẩn..." />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="ScientificName">Tên khoa học</label>
                <input asp-for="ScientificName" class="form-control" placeholder="Ví dụ: Monstera deliciosa" />
                <span asp-validation-for="ScientificName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Description">Mô tả đặc điểm</label>
                <textarea asp-for="Description" rows="3" class="form-control" placeholder="Mô tả về hình dáng, nguồn gốc, đặc tính sinh trưởng..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Ảnh đại diện giống cây</label>
                <div class="mb-2">
                    <label for="Photo"
                           id="photoDropzone"
                           class="photo-dropzone d-flex flex-column align-items-center justify-content-center text-center p-4"
                           style="overflow:hidden; border: 2px dashed rgba(255,255,255,0.15); border-radius: 8px;">
                        @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                        {
                            <img id="photoPreview" src="@Model.ExistingImageUrl" style="max-height:180px;max-width:100%;object-fit:cover;" />
                            <span id="photoPlaceholder" class="d-none" style="font-size:1.6rem;">＋</span>
                            <span id="photoPlaceholderText" class="mt-2 text-muted">Chạm để thay ảnh mới</span>
                        }
                        else
                        {
                            <span id="photoPlaceholder" style="font-size:1.6rem;">＋</span>
                            <span id="photoPlaceholderText" class="mt-2 text-muted">Tải ảnh mẫu giống cây lên</span>
                            <img id="photoPreview" class="d-none" style="max-height:180px;max-width:100%;object-fit:cover;" />
                        }
                    </label>
                    <input type="file" id="Photo" name="Photo" accept="image/*,.heic,.heif" class="d-none" />
                </div>
                <div class="mt-2">
                    <label class="form-label small text-muted">Hoặc nhập URL ảnh:</label>
                    <input asp-for="ExistingImageUrl" class="form-control form-control-sm" placeholder="https://..." />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body p-4">
            <h6 class="kicker mb-3">Hướng dẫn chăm sóc cơ bản</h6>

            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label" asp-for="Light">Ánh sáng</label>
                    <input asp-for="Light" class="form-control" placeholder="Ví dụ: Gián tiếp, râm mát" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label" asp-for="Water">Nước</label>
                    <input asp-for="Water" class="form-control" placeholder="Ví dụ: 1 lần/tuần khi đất khô" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label" asp-for="Soil">Đất trồng</label>
                    <input asp-for="Soil" class="form-control" placeholder="Ví dụ: Thoát nước tốt, giàu mùn" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label" asp-for="Fertilizer">Phân bón</label>
                    <input asp-for="Fertilizer" class="form-control" placeholder="Ví dụ: NPK loãng 1 tháng/lần" />
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-3">
        <button type="submit"
                name="action"
                value="approve"
                class="btn btn-success btn-lg flex-fill">
            ✓ Phê duyệt & Thêm vào Thư viện
        </button>

        <button type="submit"
                name="action"
                value="reject"
                class="btn btn-danger btn-lg flex-fill"
                onclick="return confirm('Bạn có chắc chắn muốn từ chối yêu cầu này? Cây của người dùng sẽ hiển thị trạng thái [Hãy nhập lại giống cây].');">
            ✕ Từ chối yêu cầu
        </button>
    </div>

</form>

<script>
    document.getElementById("Photo").addEventListener("change", function () {
        var file = this.files && this.files[0];
        if (!file) return;

        var preview = document.getElementById("photoPreview");
        preview.src = URL.createObjectURL(file);
        preview.classList.remove("d-none");
        var ph = document.getElementById("photoPlaceholder");
        if (ph) ph.classList.add("d-none");
        var pt = document.getElementById("photoPlaceholderText");
        if (pt) pt.textContent = file.name;
    });

    document.getElementById("reviewForm").addEventListener("submit", function (e) {
        var submitter = e.submitter;
        if (submitter) {
            submitter.disabled = true;
            submitter.textContent = "Đang xử lý...";
        }
    });
</script>
