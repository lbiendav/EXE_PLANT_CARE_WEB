@model List<HomePlant.Models.PlantSpeciesRequestModel>

@{
    ViewData["Title"] = "Duyệt giống cây mới";
    var currentStatus = ViewBag.CurrentStatus as string;
    var pendingCount = (int)(ViewBag.PendingCount ?? 0);
}

<a asp-action="Dashboard" class="back-link">
    ← Quản trị
</a>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="kicker">Quản trị</span>
        <h1 class="mb-0">Duyệt giống cây mới</h1>
        <p class="text-muted mt-2 mb-0">Các yêu cầu đề xuất loài cây từ người dùng khi thêm hoặc sửa cây trong vườn.</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="SamplePlants" class="btn btn-outline-secondary">
            Thư viện cây
        </a>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-action="SpeciesRequests"
       class="btn btn-sm @(string.IsNullOrEmpty(currentStatus) ? "btn-success" : "btn-outline-secondary")">
        Tất cả (@Model.Count)
    </a>
    <a asp-action="SpeciesRequests" asp-route-status="pending"
       class="btn btn-sm @(currentStatus == "pending" ? "btn-warning text-dark" : "btn-outline-secondary")">
        Đang chờ duyệt (@pendingCount)
    </a>
    <a asp-action="SpeciesRequests" asp-route-status="approved"
       class="btn btn-sm @(currentStatus == "approved" ? "btn-success" : "btn-outline-secondary")">
        Đã duyệt
    </a>
    <a asp-action="SpeciesRequests" asp-route-status="rejected"
       class="btn btn-sm @(currentStatus == "rejected" ? "btn-danger" : "btn-outline-secondary")">
        Đã từ chối
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="card">
        <div class="card-body p-5 text-center text-muted">
            <div style="font-size: 2rem;" class="mb-2">🌱</div>
            <h5>Không có yêu cầu nào</h5>
            <p class="mb-0">Hiện tại không có yêu cầu đề xuất giống cây nào trong mục này.</p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Giống cây đề xuất</th>
                        <th>Cây trong vườn</th>
                        <th>Người gửi</th>
                        <th>Thời gian</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong class="fs-6 d-block">@item.ProposedName</strong>
                                @if (!string.IsNullOrWhiteSpace(item.ScientificName))
                                {
                                    <small class="text-muted fst-italic">@item.ScientificName</small>
                                }
                            </td>
                            <td>
                                <span>@item.PlantCustomName</span>
                            </td>
                            <td>
                                <div>@item.UserDisplayName</div>
                                <small class="text-muted">@item.UserEmail</small>
                            </td>
                            <td class="text-muted small">
                                @item.CreatedAt.ToDateTime().AddHours(7).ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                <span class="badge bg-@item.StatusColorClass">
                                    @item.DisplayStatus
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="ReviewSpeciesRequest"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-success btn-sm">
                                        Xem xét & Duyệt
                                    </a>

                                    <form asp-action="DeleteSpeciesRequest"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Xóa yêu cầu này?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
