@model HomePlant.ViewModels.AdminAiDiagnosesVM

@{
    ViewData["Title"] = "Quản lý chẩn đoán AI";
}

<a asp-action="Dashboard" class="back-link">← Quản trị</a>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="kicker">Quản trị</span>
        <h1 class="mb-0">Chẩn đoán AI theo người dùng</h1>
        <p class="text-muted mt-2 mb-0">@Model.TotalCount phiên chẩn đoán · @Model.UserGroups.Count người dùng</p>
    </div>
</div>

@if (Model.UserGroups.Count == 0)
{
    <div class="card">
        <div class="card-body p-4 text-center text-muted">Chưa có lịch sử chẩn đoán AI.</div>
    </div>
}
else
{
    <div class="admin-user-groups">
        @foreach (var group in Model.UserGroups)
        {
            <details class="admin-user-group" open="@(ReferenceEquals(group, Model.UserGroups[0]) ? "open" : null)">
                <summary>
                    <span class="admin-user-initial" aria-hidden="true">@group.Initial</span>
                    <span class="admin-user-identity">
                        <strong>@group.DisplayName</strong>
                        <small>@group.Email</small>
                    </span>
                    <span class="admin-user-count">@group.Items.Count chẩn đoán</span>
                    <span class="admin-group-chevron" aria-hidden="true">⌄</span>
                </summary>

                <div class="admin-user-content">
                    <div class="row g-3">
                        @foreach (var diagnosis in group.Items)
                        {
                            var confidence = Math.Round(Math.Clamp(diagnosis.Result?.Confidence ?? 0, 0, 1) * 100);
                            <div class="col-lg-4 col-md-6">
                                <div class="card diag-card h-100">
                                    @if (!string.IsNullOrEmpty(diagnosis.UploadedImageUrl))
                                    {
                                        <img src="@diagnosis.UploadedImageUrl" alt="Ảnh cây dùng để chẩn đoán" />
                                    }

                                    <div class="card-body d-flex flex-column">
                                        <small class="text-muted mb-1">@diagnosis.PlantName</small>
                                        <h6 class="fw-bold text-danger mb-2">@diagnosis.Result?.DiseaseName</h6>

                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <div class="confidence-bar flex-fill">
                                                <div class="confidence-bar-fill" style="width:@confidence%;"></div>
                                            </div>
                                            <small class="text-muted">@confidence%</small>
                                        </div>

                                        <p class="small mb-1"><strong>Nguyên nhân:</strong> @diagnosis.Result?.Cause</p>
                                        <p class="small mb-2"><strong>Điều trị:</strong> @diagnosis.Result?.Treatment</p>
                                        <small class="text-muted d-block mb-3">
                                            @diagnosis.CreatedAt.ToDateTime().AddHours(7).ToString("dd/MM/yyyy HH:mm")
                                        </small>

                                        <form asp-action="DeleteAiDiagnosis" asp-route-id="@diagnosis.Id" method="post"
                                              class="mt-auto" onsubmit="return confirm('Xóa bản ghi chẩn đoán này?');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">Xóa</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </details>
        }
    </div>
}
