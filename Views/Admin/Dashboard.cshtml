@model HomePlant.ViewModels.AdminDashboardVM

@{
    ViewData["Title"] = "Quản trị";
}

<div class="mb-5">
    <span class="kicker">Quản trị</span>
    <h1 class="mb-0">Toàn cảnh hệ thống</h1>
    <p class="text-muted mb-0 mt-2">Toàn bộ dữ liệu HomePlant trên Firestore</p>
</div>

<div class="row g-3">

    <div class="col-lg-3 col-md-4 col-sm-6">
        <a asp-controller="Revenue" asp-action="Index" class="admin-stat-card">
            <div class="stat-number">₫</div>
            <div class="stat-label">Doanh thu</div>
        </a>
    </div>

    <div class="col-lg-3 col-md-4 col-sm-6">
        <a asp-action="Users" class="admin-stat-card">
            <div class="stat-number">@Model.UserCount</div>
            <div class="stat-label">Người dùng</div>
        </a>
    </div>

    <div class="col-lg-3 col-md-4 col-sm-6">
        <a asp-controller="Article" asp-action="Index" class="admin-stat-card">
            <div class="stat-number">@Model.ArticleCount</div>
            <div class="stat-label">Bài viết</div>
        </a>
    </div>

    <div class="col-lg-3 col-md-4 col-sm-6">
        <a asp-action="PlantTemplates" class="admin-stat-card">
            <div class="stat-number">@Model.PlantTemplateCount</div>
            <div class="stat-label">Mẫu cây cũ</div>
        </a>
    </div>

    <div class="col-lg-3 col-md-4 col-sm-6">
        <a asp-action="SamplePlants" class="admin-stat-card">
            <div class="stat-number">@Model.SamplePlantCount</div>
            <div class="stat-label">Danh mục loài cây</div>
        </a>
    </div>

    <div class="col-lg-3 col-md-4 col-sm-6">
        <a asp-action="GardenPlants" class="admin-stat-card">
            <div class="stat-number">@Model.GardenPlantCount</div>
            <div class="stat-label">Cây trong vườn</div>
        </a>
    </div>

    <div class="col-lg-3 col-md-4 col-sm-6">
        <a asp-action="CommunityPosts" class="admin-stat-card">
            <div class="stat-number">@Model.CommunityPostCount</div>
            <div class="stat-label">Bài đăng cộng đồng</div>
        </a>
    </div>

    <div class="col-lg-3 col-md-4 col-sm-6">
        <a asp-action="QaThreads" class="admin-stat-card">
            <div class="stat-number">@Model.QaThreadCount</div>
            <div class="stat-label">Câu hỏi chuyên gia</div>
        </a>
    </div>

    <div class="col-lg-3 col-md-4 col-sm-6">
        <a asp-action="AiDiagnoses" class="admin-stat-card">
            <div class="stat-number">@Model.AiDiagnosisCount</div>
            <div class="stat-label">Chẩn đoán AI</div>
        </a>
    </div>

</div>

<section class="mt-5">
    <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
        <div>
            <span class="kicker">Google Analytics 4</span>
            <h2 class="h3 mb-0">Thống kê lưu lượng & hành vi người dùng</h2>
        </div>
        <div class="d-flex gap-2">
            <a href="https://analytics.google.com" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-success">
                Mở GA4 Console &rarr;
            </a>
        </div>
    </div>

    @if (!Model.Analytics.Configured)
    {
        <div class="status-panel">
            <p class="text-muted mb-2">
                Chưa bật hoặc chưa cấu hình đầy đủ Google Analytics.
            </p>
            <p class="small text-muted mb-0">
                Để kích hoạt: cấu hình <code>GoogleAnalytics:MeasurementId</code> (mã dạng <code>G-XXXXXXXXXX</code> để thu thập truy cập và User-ID) và <code>GoogleAnalytics:PropertyId</code> (mã số Property để hiển thị báo cáo tự động tại đây).
            </p>
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.Analytics.Error))
    {
        <div class="alert alert-warning">@Model.Analytics.Error</div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-lg-3 col-sm-6">
                <div class="status-panel analytics-metric h-100">
                    <strong>@Model.Analytics.ActiveUsers30Days.ToString("N0")</strong>
                    <span>Người truy cập (30 ngày)</span>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="status-panel analytics-metric h-100">
                    <strong>@Model.Analytics.Sessions30Days.ToString("N0")</strong>
                    <span>Phiên hoạt động</span>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="status-panel analytics-metric h-100">
                    <strong>@Model.Analytics.PageViews30Days.ToString("N0")</strong>
                    <span>Lượt xem trang</span>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="status-panel analytics-metric h-100">
                    <strong>@Model.Analytics.FormattedAverageEngagement</strong>
                    <span>Thời gian tương tác TB</span>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-xl-6">
                <div class="status-panel h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="h6 text-uppercase mb-0">Lượt truy cập mỗi ngày (30 ngày qua)</h3>
                        <small class="text-muted">Tổng · Mới · Cũ · Phiên · Xem</small>
                    </div>

                    <div class="mb-3 p-3 rounded" style="background: rgba(208, 234, 144, 0.08); border: 1px solid rgba(208, 234, 144, 0.25);">
                        <span class="small text-muted d-block mb-1 text-uppercase fw-semibold" style="letter-spacing: .08em;">Trung bình 1 ngày (trong 30 ngày qua)</span>
                        <div class="d-flex flex-wrap gap-4 align-items-baseline">
                            <div><strong class="fs-5 text-success">@Model.Analytics.AverageDailyUsers30Days.ToString("N1")</strong> <small class="text-muted">user / ngày</small></div>
                            <div><strong class="fs-5 text-success">@Model.Analytics.AverageDailySessions30Days.ToString("N1")</strong> <small class="text-muted">phiên / ngày</small></div>
                            <div><strong class="fs-5 text-success">@Model.Analytics.AverageDailyPageViews30Days.ToString("N1")</strong> <small class="text-muted">lượt xem / ngày</small></div>
                        </div>
                    </div>

                    @if (Model.Analytics.DailyTrends.Count == 0)
                    {
                        <p class="text-muted small mb-0">Chưa có đủ dữ liệu theo ngày trong khoảng thời gian này.</p>
                    }
                    else
                    {
                        var maxDailyUsers = Math.Max(1, Model.Analytics.DailyTrends.Max(d => d.ActiveUsers));
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th style="width: 65px;">Ngày</th>
                                        <th>Mật độ</th>
                                        <th class="text-end" style="width: 55px;" title="Tổng số User trong ngày">Tổng</th>
                                        <th class="text-end text-success" style="width: 55px;" title="User mới truy cập lần đầu">Mới</th>
                                        <th class="text-end text-info" style="width: 55px;" title="User cũ quay lại">Cũ</th>
                                        <th class="text-end" style="width: 55px;">Phiên</th>
                                        <th class="text-end" style="width: 55px;">Xem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var day in Model.Analytics.DailyTrends)
                                    {
                                        var pct = Math.Round((double)day.ActiveUsers / maxDailyUsers * 100);
                                        <tr>
                                            <td class="text-nowrap"><strong>@day.DisplayDate</strong></td>
                                            <td>
                                                <div class="progress" style="height: 6px; background-color: var(--hair-soft);">
                                                    <div class="progress-bar" role="progressbar" style="width: @(pct)%; background-color: var(--green);" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                            </td>
                                            <td class="text-end font-monospace">
                                                @if (day.ActiveUsers > 0)
                                                {
                                                    <button type="button" class="btn btn-link p-0 text-decoration-none fw-semibold text-light" onclick="openDailyUsersModal('@day.DateKey', '@day.DisplayDate', 'all')" title="Xem chi tiết người dùng ngày @day.DisplayDate">@day.ActiveUsers</button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">0</span>
                                                }
                                            </td>
                                            <td class="text-end font-monospace">
                                                @if (day.NewUsers > 0)
                                                {
                                                    <button type="button" class="btn btn-link p-0 text-decoration-none fw-bold text-success text-decoration-underline" onclick="openDailyUsersModal('@day.DateKey', '@day.DisplayDate', 'new')" title="Xem chi tiết User MỚI ngày @day.DisplayDate">@day.NewUsers</button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">0</span>
                                                }
                                            </td>
                                            <td class="text-end font-monospace">
                                                @if (day.ReturningUsers > 0)
                                                {
                                                    <button type="button" class="btn btn-link p-0 text-decoration-none fw-bold text-info text-decoration-underline" onclick="openDailyUsersModal('@day.DateKey', '@day.DisplayDate', 'returning')" title="Xem chi tiết User CŨ ngày @day.DisplayDate">@day.ReturningUsers</button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">0</span>
                                                }
                                            </td>
                                            <td class="text-end font-monospace text-muted">@day.Sessions</td>
                                            <td class="text-end font-monospace text-muted">@day.PageViews</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <div class="col-xl-6">
                <div class="status-panel h-100 d-flex flex-column justify-content-between">
                    <div>
                        <h3 class="h6 text-uppercase mb-3">Nguồn truy cập (Traffic Sources)</h3>
                        @if (Model.Analytics.TrafficSources.Count == 0)
                        {
                            <p class="text-muted small mb-0">Chưa ghi nhận nguồn traffic.</p>
                        }
                        else
                        {
                            @foreach (var source in Model.Analytics.TrafficSources)
                            {
                                <div class="analytics-row">
                                    <span>@source.Label</span>
                                    <strong>@source.Value.ToString("N0") phiên</strong>
                                </div>
                            }
                        }
                    </div>

                    <div class="p-3 mt-3 rounded" style="background: rgba(46, 125, 50, 0.08); border: 1px dashed var(--green);">
                        <h4 class="h6 mb-1 text-success">Theo dõi hành vi của TỪNG USER cụ thể</h4>
                        <p class="small text-muted mb-2">
                            Website đã tự động lưu nhật ký hoạt động trực tiếp vào cơ sở dữ liệu và đồng bộ User-ID lên GA4.
                        </p>
                        <p class="small text-muted mb-3">
                            Xem chi tiết số lần ghé thăm, lần cuối vào web và dòng thời gian thao tác của từng tài khoản ngay trên web:
                        </p>
                        <a asp-action="Users" class="btn btn-sm btn-outline-success">Xem nhật ký & hoạt động từng User &rarr;</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="status-panel h-100">
                    <h3 class="h6 text-uppercase mb-3">Trang được truy cập nhiều nhất & Thời gian trên trang</h3>
                    @if (Model.Analytics.PopularPages.Count == 0)
                    {
                        <p class="text-muted small mb-0">Chưa có dữ liệu trang.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Trang / Đường dẫn</th>
                                        <th class="text-end">Lượt xem</th>
                                        <th class="text-end">Số User</th>
                                        <th class="text-end">Thời gian TB</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Analytics.PopularPages)
                                    {
                                        <tr>
                                            <td>
                                                <strong class="d-block text-truncate" style="max-width: 320px;">@(string.IsNullOrWhiteSpace(item.Title) ? item.Path : item.Title)</strong>
                                                <code class="small text-muted">@item.Path</code>
                                            </td>
                                            <td class="text-end font-monospace">@item.Views.ToString("N0")</td>
                                            <td class="text-end font-monospace text-muted">@item.Users.ToString("N0")</td>
                                            <td class="text-end text-nowrap"><span class="badge bg-success-subtle text-success border border-success-subtle">@item.FormattedDuration</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-5">
                <div class="status-panel h-100">
                    <h3 class="h6 text-uppercase mb-3">Trang ít lượt xem nhất (Cần tối ưu nội dung)</h3>
                    @if (Model.Analytics.LeastVisitedPages.Count == 0)
                    {
                        <p class="text-muted small mb-0">Chưa có dữ liệu thống kê trang ít xem.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Trang</th>
                                        <th class="text-end">Lượt xem</th>
                                        <th class="text-end">Thời gian TB</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Analytics.LeastVisitedPages)
                                    {
                                        <tr>
                                            <td>
                                                <span class="d-block text-truncate" style="max-width: 220px;">@(string.IsNullOrWhiteSpace(item.Title) ? item.Path : item.Title)</span>
                                                <code class="small text-muted">@item.Path</code>
                                            </td>
                                            <td class="text-end font-monospace text-warning">@item.Views.ToString("N0")</td>
                                            <td class="text-end text-nowrap"><span class="badge bg-secondary-subtle text-muted">@item.FormattedDuration</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</section>

<!-- Modal xem chi tiết người dùng mới / cũ theo ngày -->
<div class="modal fade" id="dailyUsersModal" tabindex="-1" aria-labelledby="dailyUsersModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content" style="background-color: var(--bg-surface, #15221c); color: var(--ink, #e0ede4); border: 1px solid var(--hair-soft, rgba(208, 234, 144, 0.2));">
            <div class="modal-header border-bottom border-secondary-subtle">
                <div>
                    <h5 class="modal-title h5 mb-1" id="dailyUsersModalTitle">Chi tiết người dùng</h5>
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-light active" id="btnTabAll" onclick="filterDailyUsers('all')">
                                Tất cả (<span id="modalCountAll">0</span>)
                            </button>
                            <button type="button" class="btn btn-outline-success" id="btnTabNew" onclick="filterDailyUsers('new')">
                                User Mới (<span id="modalCountNew">0</span>)
                            </button>
                            <button type="button" class="btn btn-outline-info" id="btnTabReturning" onclick="filterDailyUsers('returning')">
                                User Cũ (<span id="modalCountReturning">0</span>)
                            </button>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-3">
                <div id="dailyUsersLoading" class="text-center py-5">
                    <div class="spinner-border text-success" role="status"></div>
                    <p class="text-muted mt-2 mb-0">Đang tải danh sách người dùng và các trang đã xem...</p>
                </div>
                <div id="dailyUsersEmpty" class="text-center py-5 d-none">
                    <div class="text-muted mb-2">
                        <svg width="42" height="42" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    </div>
                    <h6 class="text-muted mb-1" id="dailyUsersEmptyMsg">Không có dữ liệu người dùng trong mục này.</h6>
                    <small class="text-muted d-block">Danh tính cụ thể (tên, email, các trang đã xem) được tự động ghi nhận khi người dùng thao tác trên website HomePlant.</small>
                </div>
                <div id="dailyUsersContainer" class="d-flex flex-column gap-3 d-none"></div>
            </div>
            <div class="modal-footer border-top border-secondary-subtle">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
let allDailyUsers = [];
let currentFilterType = 'all';

function openDailyUsersModal(dateKey, displayDate, type) {
    currentFilterType = type || 'all';
    document.getElementById('dailyUsersModalTitle').innerHTML = 'Người dùng truy cập ngày <span class="text-success font-monospace">' + displayDate + '</span>';
    
    const loading = document.getElementById('dailyUsersLoading');
    const empty = document.getElementById('dailyUsersEmpty');
    const container = document.getElementById('dailyUsersContainer');

    loading.classList.remove('d-none');
    empty.classList.add('d-none');
    container.classList.add('d-none');
    container.innerHTML = '';

    const modal = new bootstrap.Modal(document.getElementById('dailyUsersModal'));
    modal.show();

    fetch('/Admin/DailyUsers?date=' + encodeURIComponent(dateKey) + '&type=all')
        .then(res => res.json())
        .then(data => {
            loading.classList.add('d-none');
            allDailyUsers = (data && data.users) ? data.users : [];

            const countNew = allDailyUsers.filter(u => u.isNew).length;
            const countRet = allDailyUsers.filter(u => !u.isNew).length;

            document.getElementById('modalCountAll').innerText = allDailyUsers.length;
            document.getElementById('modalCountNew').innerText = countNew;
            document.getElementById('modalCountReturning').innerText = countRet;

            filterDailyUsers(currentFilterType);
        })
        .catch(err => {
            loading.classList.add('d-none');
            empty.classList.remove('d-none');
            document.getElementById('dailyUsersEmptyMsg').innerText = 'Không thể tải dữ liệu: ' + err.message;
        });
}

function filterDailyUsers(type) {
    currentFilterType = type;
    document.getElementById('btnTabAll').classList.toggle('active', type === 'all');
    document.getElementById('btnTabNew').classList.toggle('active', type === 'new');
    document.getElementById('btnTabReturning').classList.toggle('active', type === 'returning');

    const empty = document.getElementById('dailyUsersEmpty');
    const container = document.getElementById('dailyUsersContainer');
    container.innerHTML = '';

    let filtered = allDailyUsers;
    if (type === 'new') filtered = allDailyUsers.filter(u => u.isNew);
    if (type === 'returning') filtered = allDailyUsers.filter(u => !u.isNew);

    if (filtered.length === 0) {
        empty.classList.remove('d-none');
        container.classList.add('d-none');
        if (type === 'returning' && allDailyUsers.some(u => u.isNew)) {
            const countNew = allDailyUsers.filter(u => u.isNew).length;
            document.getElementById('dailyUsersEmptyMsg').innerHTML = 
                'Ngày này không có User cũ quay lại.<br><button type="button" class="btn btn-sm btn-outline-success mt-2" onclick="filterDailyUsers(\'new\')">Xem ' + countNew + ' User Mới</button>';
        } else if (type === 'new' && allDailyUsers.some(u => !u.isNew)) {
            const countRet = allDailyUsers.filter(u => !u.isNew).length;
            document.getElementById('dailyUsersEmptyMsg').innerHTML = 
                'Ngày này không có User mới đăng ký.<br><button type="button" class="btn btn-sm btn-outline-info mt-2" onclick="filterDailyUsers(\'returning\')">Xem ' + countRet + ' User Cũ</button>';
        } else {
            document.getElementById('dailyUsersEmptyMsg').innerText = 'Không có dữ liệu người dùng trong mục này.';
        }
        return;
    }

    empty.classList.add('d-none');
    container.classList.remove('d-none');

    filtered.forEach((u) => {
        const card = document.createElement('div');
        card.className = 'p-3 rounded border';
        card.style.background = 'rgba(255, 255, 255, 0.03)';
        card.style.borderColor = 'rgba(208, 234, 144, 0.15)';

        const isNewBadge = u.isNew 
            ? '<span class="badge bg-success-subtle text-success border border-success-subtle">User Mới</span>' 
            : '<span class="badge bg-info-subtle text-info border border-info-subtle">User Cũ</span>';
            
        const guestBadge = u.isGuest 
            ? '<span class="badge bg-secondary-subtle text-muted">Khách chưa đăng nhập</span>' 
            : '<span class="badge bg-primary-subtle text-primary">Tài khoản</span>';

        let activitiesHtml = '';
        if (u.activities && u.activities.length > 0) {
            activitiesHtml = `
                <div class="mt-3 pt-2 border-top border-secondary-subtle">
                    <small class="text-muted text-uppercase fw-semibold d-block mb-2" style="letter-spacing: .05em; font-size: 0.75rem;">
                        Các trang đã xem trong phiên (${u.activities.length} lượt):
                    </small>
                    <div class="d-flex flex-column gap-2" style="max-height: 220px; overflow-y: auto;">
                        ${u.activities.map(a => `
                            <div class="d-flex align-items-baseline gap-2 small">
                                <span class="font-monospace text-muted" style="font-size: 0.8rem; min-width: 58px;">${a.time}</span>
                                <span class="badge bg-secondary-subtle text-light px-1">${a.action || 'Xem'}</span>
                                <strong class="text-success text-truncate">${a.title}</strong>
                                <code class="text-muted small">${a.path}</code>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
        } else {
            activitiesHtml = '<div class="mt-2 text-muted small fst-italic">Chưa có chi tiết trang cụ thể cho phiên này.</div>';
        }

        const avatar = u.avatarUrl || ('https://i.pravatar.cc/150?u=' + encodeURIComponent(u.uid));

        card.innerHTML = `
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <img src="${avatar}" class="rounded-circle" width="36" height="36" style="object-fit: cover; border: 1px solid rgba(208, 234, 144, 0.3);" alt="${u.fullName}"/>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <strong class="text-light">${u.fullName}</strong>
                            ${isNewBadge}
                            ${guestBadge}
                        </div>
                        <small class="text-muted">${u.email || u.uid}</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 font-monospace small">
                    <span class="badge bg-dark border border-secondary-subtle text-light">${u.sessionCount || 1} phiên</span>
                    <span class="badge bg-dark border border-secondary-subtle text-success">${u.pageViewCount || (u.activities ? u.activities.length : 1)} lượt xem</span>
                </div>
            </div>
            ${activitiesHtml}
        `;
        container.appendChild(card);
    });
}
</script>
}

