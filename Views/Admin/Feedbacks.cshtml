@model List<HomePlant.Models.FeedbackModel>

@{
    ViewData["Title"] = "Duyệt đánh giá & Cảm nhận";
    var currentStatus = (ViewBag.CurrentStatus as string) ?? "all";
    var pendingCount = (int)(ViewBag.PendingCount ?? 0);
}

<a asp-action="Dashboard" class="back-link">
    ← Quản trị
</a>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="kicker">Quản trị</span>
        <h1 class="mb-0">Duyệt đánh giá &amp; Cảm nhận</h1>
        <p class="text-muted mb-0 mt-1">Đánh giá gửi từ mục "Góc chia sẻ" cần được admin duyệt trước khi xuất hiện trên trang chủ.</p>
    </div>

    <!-- Status Filter Pills -->
    <div class="d-flex gap-2">
        <a asp-action="Feedbacks" asp-route-status="all" class="btn btn-sm @(currentStatus == "all" ? "btn-success" : "btn-outline-secondary")">
            Tất cả (@Model.Count)
        </a>
        <a asp-action="Feedbacks" asp-route-status="pending" class="btn btn-sm @(currentStatus == "pending" ? "btn-warning" : "btn-outline-warning")">
            Chờ duyệt @(pendingCount > 0 ? $"({pendingCount})" : "")
        </a>
        <a asp-action="Feedbacks" asp-route-status="approved" class="btn btn-sm @(currentStatus == "approved" ? "btn-success" : "btn-outline-secondary")">
            Đã duyệt
        </a>
        <a asp-action="Feedbacks" asp-route-status="hidden" class="btn btn-sm @(currentStatus == "hidden" ? "btn-secondary" : "btn-outline-secondary")">
            Đã ẩn
        </a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-garden text-center py-5 px-4">
        <span class="kicker d-block mb-2">Trống</span>
        <h3>Không có đánh giá nào trong mục này</h3>
        <p class="text-muted">Các phản hồi mới gửi từ người dùng sẽ xuất hiện tại đây để admin kiểm duyệt.</p>
        <a asp-action="Feedbacks" asp-route-status="all" class="btn btn-outline-success btn-sm mt-2">Xem tất cả</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var fb in Model)
        {
            var initial = !string.IsNullOrWhiteSpace(fb.UserName) ? fb.UserName.Trim()[0].ToString().ToUpperInvariant() : "U";
            var statusBadgeClass = fb.Status switch
            {
                "approved" => "bg-success",
                "hidden" => "bg-secondary",
                _ => "bg-warning text-dark"
            };
            var statusLabel = fb.Status switch
            {
                "approved" => "Đã duyệt (Hiện Home)",
                "hidden" => "Đã ẩn",
                _ => "Chờ duyệt"
            };

            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 shadow-sm surface">
                    <div class="card-body p-4 d-flex flex-column">

                        <!-- Top Meta -->
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                            <span class="badge @statusBadgeClass">@statusLabel</span>
                            <small class="text-muted">@fb.CreatedAt.ToDateTime().ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        </div>

                        <!-- Tag & Rating -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-dark border border-secondary text-light">
                                @fb.TagIcon @fb.Tag
                            </span>
                            <span class="text-warning fw-bold">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    @(i <= fb.Rating ? "★" : "☆")
                                }
                            </span>
                        </div>

                        <!-- Title & Content -->
                        <h5 class="fw-bold text-bone mt-2 mb-2">@fb.Title</h5>
                        <p class="text-muted small fst-italic flex-grow-1" style="white-space: pre-line;">
                            "@fb.Content"
                        </p>

                        <!-- Author -->
                        <div class="d-flex align-items-center gap-3 pt-3 border-top border-secondary mt-3">
                            <div class="rounded-circle bg-success text-dark d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                                @initial
                            </div>
                            <div class="small">
                                <div class="fw-bold text-bone">@fb.UserName</div>
                                <div class="text-muted">@fb.UserSubtitle</div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2 mt-3 pt-2">
                            @if (fb.Status != "approved")
                            {
                                <form asp-action="UpdateFeedbackStatus" asp-route-id="@fb.Id" asp-route-status="approved" method="post" class="flex-fill">
                                    <button type="submit" class="btn btn-success btn-sm w-100">
                                        ✓ Duyệt hiển thị
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="UpdateFeedbackStatus" asp-route-id="@fb.Id" asp-route-status="hidden" method="post" class="flex-fill">
                                    <button type="submit" class="btn btn-outline-warning btn-sm w-100">
                                        Ẩn khỏi Home
                                    </button>
                                </form>
                            }

                            <form asp-action="DeleteFeedback" asp-route-id="@fb.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa vĩnh viễn đánh giá này?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Xóa">
                                    Xóa
                                </button>
                            </form>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}
