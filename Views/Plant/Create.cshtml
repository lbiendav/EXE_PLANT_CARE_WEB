@model HomePlant.ViewModels.PlantCreateVM

@{
    ViewData["Title"] = "Thêm cây mới";
}

<a asp-action="Index" class="back-link">
    ← Vườn của tôi
</a>

<div class="mb-4">
    <span class="kicker">Trang mới trong nhật ký</span>
    <h1>Thêm cây mới</h1>
</div>

<form method="post" enctype="multipart/form-data" style="max-width:520px;" id="plantCreateForm">
    <input asp-for="SourceDiagnosisId" type="hidden" />

    @if ((ViewBag.AiScheduleLoaded as bool?) == true)
    {
        <div class="alert alert-success mb-4" role="status">
            <strong>Đã nạp lịch chăm sóc AI.</strong>
            @if (!string.IsNullOrWhiteSpace(ViewBag.AiIdentifiedPlant as string))
            {
                <span>Khuyến nghị dành cho @ViewBag.AiIdentifiedPlant.</span>
            }
            Bạn có thể điều chỉnh trước khi lưu cây.
        </div>
    }

    <div class="mb-3">
        <label for="Photo"
               id="photoDropzone"
               class="photo-dropzone d-flex flex-column align-items-center justify-content-center text-center p-5"
               style="overflow:hidden;">
            <span id="photoPlaceholder" style="font-size:1.6rem;">＋</span>
            <span id="photoPlaceholderText" class="mt-2">Chạm để thêm ảnh</span>
            <img id="photoPreview" class="d-none" style="max-height:220px;max-width:100%;object-fit:cover;" />
        </label>
        <input type="file" id="Photo" name="Photo" accept="image/*,.heic,.heif" class="d-none" />
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Nickname">Tên gọi</label>
        <input asp-for="Nickname"
               class="form-control"
               placeholder="Ví dụ: Bé Sen Đá Góc Bàn" />
        <span asp-validation-for="Nickname" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="PlantSampleId">Loại cây (từ thư viện)</label>
        <select asp-for="PlantSampleId"
                asp-items="ViewBag.PlantSamples"
                class="form-select">
            <option value="">Chọn loại cây</option>
        </select>
        <span asp-validation-for="PlantSampleId" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label class="form-label" asp-for="CurrentStatus">Trạng thái sức khỏe</label>
        <select asp-for="CurrentStatus" class="form-select">
            <option>Khỏe mạnh</option>
            <option>Cần chú ý</option>
            <option>Bị bệnh</option>
        </select>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h6 class="kicker mb-2">Lịch nhắc chăm sóc</h6>
            @if ((ViewBag.AiScheduleLoaded as bool?) == true)
            {
                <span class="expert-applied-badge d-inline-block mb-2">Đề xuất bởi AI</span>
            }
            <p class="text-muted small">Đặt chu kỳ theo giây, phút, giờ hoặc ngày. Bạn có thể thay đổi lịch sau trong trang chi tiết cây.</p>
            <div class="row g-3">
                <div class="col-sm-4">
                    <label class="form-label" asp-for="WateringFrequency">Tưới nước</label>
                    <div class="input-group">
                        <input asp-for="WateringFrequency" type="number" min="1" max="3650" class="form-control" placeholder="7" />
                        <select asp-for="WateringFrequencyUnit" class="form-select schedule-unit" aria-label="Đơn vị tưới nước">
                            <option value="Seconds">giây</option>
                            <option value="Minutes">phút</option>
                            <option value="Hours">giờ</option>
                            <option value="Days">ngày</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-4">
                    <label class="form-label" asp-for="FertilizingFrequency">Bón phân</label>
                    <div class="input-group">
                        <input asp-for="FertilizingFrequency" type="number" min="1" max="3650" class="form-control" placeholder="30" />
                        <select asp-for="FertilizingFrequencyUnit" class="form-select schedule-unit" aria-label="Đơn vị bón phân">
                            <option value="Seconds">giây</option>
                            <option value="Minutes">phút</option>
                            <option value="Hours">giờ</option>
                            <option value="Days">ngày</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-4">
                    <label class="form-label" asp-for="RepottingFrequency">Thay chậu</label>
                    <div class="input-group">
                        <input asp-for="RepottingFrequency" type="number" min="1" max="3650" class="form-control" placeholder="365" />
                        <select asp-for="RepottingFrequencyUnit" class="form-select schedule-unit" aria-label="Đơn vị thay chậu">
                            <option value="Seconds">giây</option>
                            <option value="Minutes">phút</option>
                            <option value="Hours">giờ</option>
                            <option value="Days">ngày</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="mt-2">
                <span asp-validation-for="WateringFrequency" class="text-danger small d-block"></span>
                <span asp-validation-for="WateringFrequencyUnit" class="text-danger small d-block"></span>
                <span asp-validation-for="FertilizingFrequency" class="text-danger small d-block"></span>
                <span asp-validation-for="FertilizingFrequencyUnit" class="text-danger small d-block"></span>
                <span asp-validation-for="RepottingFrequency" class="text-danger small d-block"></span>
                <span asp-validation-for="RepottingFrequencyUnit" class="text-danger small d-block"></span>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-success btn-lg w-100">
        Lưu vào vườn
    </button>

</form>

<script>
    document.getElementById("Photo").addEventListener("change", function () {
        var file = this.files && this.files[0];

        var preview = document.getElementById("photoPreview");
        var placeholder = document.getElementById("photoPlaceholder");
        var placeholderText = document.getElementById("photoPlaceholderText");

        if (!file) {
            preview.classList.add("d-none");
            placeholder.classList.remove("d-none");
            placeholderText.classList.remove("d-none");
            return;
        }

        preview.src = URL.createObjectURL(file);
        preview.classList.remove("d-none");
        placeholder.classList.add("d-none");
        placeholderText.textContent = file.name;
    });

    document.getElementById("plantCreateForm").addEventListener("submit", function () {
        var button = this.querySelector('button[type="submit"]');
        button.disabled = true;
        button.textContent = "Đang lưu...";
    });
</script>
