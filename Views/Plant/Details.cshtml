@using HomePlant.Models
@model UserPlantModel

@{
    ViewData["Title"] = Model.CustomName;
    var species = ViewBag.Species as HomePlant.ViewModels.PlantSpeciesVM;
    var now = Google.Cloud.Firestore.Timestamp.GetCurrentTimestamp();
    string FormatDate(Google.Cloud.Firestore.Timestamp? value) =>
        value.HasValue ? value.Value.ToDateTime().AddHours(7).ToString("dd/MM/yyyy HH:mm") : "Chưa thiết lập";
}

<style>
    .detail-hero {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--hair-soft);
    }

    .detail-hero img {
        width: 100%;
        height: 320px;
        object-fit: cover;
    }
</style>

<a asp-action="Index" class="back-link">
    ← Vườn của tôi
</a>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="detail-hero">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://i.ibb.co/MkMj38WM/plant.png" : Model.ImageUrl)"
                 alt="@Model.CustomName" />
            <span class="status-pill bg-@Model.StatusColorClass">@Model.DisplayStatus</span>
        </div>

        @if (species != null)
        {
            <div class="card mt-3">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-1">@species.Name</h5>
                    <p class="text-muted fst-italic mb-2">@species.ScientificName</p>
                    <p class="text-muted mb-3">@species.Description</p>

                    @if (species.Care != null)
                    {
                        <div class="field-row">
                            <span class="field-label">Ánh sáng</span>
                            <span class="field-value">@species.Care.Light</span>
                        </div>
                        <div class="field-row">
                            <span class="field-label">Nước</span>
                            <span class="field-value">@species.Care.Water</span>
                        </div>
                        <div class="field-row">
                            <span class="field-label">Đất</span>
                            <span class="field-value">@species.Care.Soil</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-lg-7">
        <span class="kicker">Nhật ký cây</span>
        <h1 class="mb-1">@Model.CustomName</h1>
        <p class="text-muted mb-4">Chi tiết cây trong vườn của bạn</p>

        <div class="card mb-3">
            <div class="card-body p-4">
                <h6 class="kicker mb-3">Thông tin chung</h6>

                <div class="field-row">
                    <span class="field-label">Loài cây</span>
                    <span class="field-value">@(species?.Name ?? "Chưa xác định")</span>
                </div>
                <div class="field-row">
                    <span class="field-label">Bắt đầu chăm từ</span>
                    <span class="field-value">@Model.PlantedAt.ToDateTime().AddHours(7).ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body p-4">
                <h6 class="kicker mb-3">Lịch chăm sóc</h6>

                <div class="care-grid">
                    @foreach (var task in new[]
                    {
                        new { Type = "Watering", Label = "Tưới nước", Last = Model.LastWatered, Next = Model.NextWateringAt, Frequency = Model.WateringFrequency },
                        new { Type = "Fertilizing", Label = "Bón phân", Last = Model.LastFertilized, Next = Model.NextFertilizingAt, Frequency = Model.FertilizingFrequency },
                        new { Type = "Repotting", Label = "Thay chậu", Last = Model.LastRepotted, Next = Model.NextRepottingAt, Frequency = Model.RepottingFrequency }
                    })
                    {
                        var isDue = task.Next.HasValue && task.Next.Value <= now;
                        <div class="care-task @(isDue ? "is-due" : "")">
                            <div class="care-task-label">@task.Label</div>
                            <div class="care-task-date">@(isDue ? "Đã đến hạn · " : "")@FormatDate(task.Next)</div>
                            <div class="text-muted small mb-3">
                                @(task.Frequency.HasValue ? $"Mỗi {task.Frequency} ngày" : "Chưa đặt tần suất")
                                <br />Lần gần nhất: @(task.Last.HasValue ? task.Last.Value.ToDateTime().AddHours(7).ToString("dd/MM/yyyy") : "Chưa ghi nhận")
                            </div>
                            <form asp-controller="CareLog" asp-action="QuickCreate" method="post">
                                <input type="hidden" name="plantId" value="@Model.Id" />
                                <input type="hidden" name="actionType" value="@task.Type" />
                                <button type="submit" class="btn btn-outline-success btn-sm w-100">Đã @task.Label.ToLowerInvariant()</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-success">
                Sửa cây
            </a>
            <a asp-controller="CareLog"
               asp-action="Index"
               asp-route-plantId="@Model.Id"
               class="btn btn-outline-success">
                Xem lịch sử chăm sóc
            </a>
        </div>
    </div>
</div>
