@model string

@{
    ViewData["Title"] = "Kiểm tra email";
}

<div class="text-center py-5" style="max-width:520px;margin:0 auto;">

    <span class="kicker">Hạt đã gieo</span>

    <h1 class="mt-2">Kiểm tra email của bạn</h1>

    <p class="text-muted mt-3">
        Chúng tôi đã gửi một liên kết xác thực đến <strong class="text-success">@Model</strong>.
        Nhấp vào liên kết đó để kích hoạt tài khoản trước khi đăng nhập.
    </p>

    <p class="text-muted small">
        Lưu ý: Liên kết xác thực có hiệu lực trong vòng <strong>3 ngày (72 giờ)</strong>. Vui lòng kiểm tra cả thư mục Spam/Rác.
    </p>

    <div class="d-flex justify-content-center gap-2 mt-3">
        <a asp-action="Login" class="btn btn-success">
            Quay lại đăng nhập
        </a>
        <a asp-action="Register" class="btn btn-outline-secondary">
            Đăng ký lại
        </a>
    </div>

</div>
