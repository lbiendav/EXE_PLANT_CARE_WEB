@model HomePlant.ViewModels.RevenueDashboardVM
@using HomePlant.Models
@{
    ViewData["Title"] = "Doanh thu";
    var tabs = new[] { ("overview", "Tổng quan"), ("orders", "Đơn thanh toán"), ("subscriptions", "Thuê bao"), ("plans", "Bảng giá"), ("customers", "Khách hàng"), ("audit", "Nhật ký") };
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div><span class="kicker">Quản trị</span><h1 class="mb-1">Doanh thu</h1><p class="text-muted mb-0">Thanh toán, thuê bao và hỗ trợ khách hàng trong một nơi.</p></div>
    <span class="badge @(Model.PayOsConfigured ? "bg-success" : "bg-danger")">payOS: @(Model.PayOsConfigured ? "Đã cấu hình" : "Thiếu cấu hình")</span>
</div>
<nav class="revenue-tabs mb-4" aria-label="Các mục doanh thu">
@foreach (var tab in tabs) { <a class="btn @(Model.Tab == tab.Item1 ? "btn-success" : "btn-outline-secondary")" asp-action="Index" asp-route-tab="@tab.Item1">@tab.Item2</a> }
</nav>

@if (Model.Tab == "overview")
{
    var attentionOrders = Model.NeedsReviewOrders + Model.UnmatchedTransactions;
    <section class="revenue-summary" aria-labelledby="business-summary-title">
        <div class="d-flex justify-content-between align-items-end gap-3 mb-3">
            <div><span class="kicker">Vận hành</span><h2 id="business-summary-title" class="h3 mb-0">Tình hình kinh doanh</h2></div>
            <small class="text-muted">Tài khoản mới và doanh thu tính trong 30 ngày gần nhất</small>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6"><a class="admin-stat-card revenue-stat-link h-100" asp-action="Index" asp-route-tab="overview" asp-route-detail="accounts" aria-label="Xem danh sách tất cả tài khoản"><div class="stat-number">@Model.TotalAccounts</div><div class="stat-label">Tổng tài khoản</div><small class="text-muted">+@Model.NewAccounts30Days tài khoản mới</small><span class="revenue-stat-action">Xem chi tiết →</span></a></div>
            <div class="col-xl-3 col-md-6"><a class="admin-stat-card revenue-stat-link h-100" asp-action="Index" asp-route-tab="overview" asp-route-detail="active-subscriptions" aria-label="Xem các gói đang hoạt động"><div class="stat-number">@Model.ActiveSubscriptions</div><div class="stat-label">Gói đang hoạt động</div><span class="revenue-stat-action">Xem chi tiết →</span></a></div>
            <div class="col-xl-3 col-md-6"><a class="admin-stat-card revenue-stat-link h-100" asp-action="Index" asp-route-tab="overview" asp-route-detail="paying-customers" aria-label="Xem người dùng đã thanh toán"><div class="stat-number">@Model.PayingCustomers</div><div class="stat-label">Người đã thanh toán</div><small class="text-muted">@Model.SuccessfulOrders giao dịch thành công</small><span class="revenue-stat-action">Xem chi tiết →</span></a></div>
            <div class="col-xl-3 col-md-6"><a class="admin-stat-card revenue-stat-link h-100" asp-action="Index" asp-route-tab="overview" asp-route-detail="revenue-30d" aria-label="Xem các đơn tạo doanh thu 30 ngày"><div class="stat-number">@Model.Revenue30Days.ToString("N0")đ</div><div class="stat-label">Doanh thu 30 ngày</div><small class="text-muted">Hôm nay @Model.RevenueToday.ToString("N0")đ · 7 ngày @Model.Revenue7Days.ToString("N0")đ</small><span class="revenue-stat-action">Xem chi tiết →</span></a></div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-lg-3 col-6"><a class="status-panel revenue-stat-link h-100" asp-action="Index" asp-route-tab="overview" asp-route-detail="pending-orders"><strong class="fs-3">@Model.PendingOrders</strong><div class="text-muted">Đơn đang chờ</div><span class="revenue-stat-action">Xem chi tiết →</span></a></div>
            <div class="col-lg-3 col-6"><a class="status-panel revenue-stat-link h-100" asp-action="Index" asp-route-tab="overview" asp-route-detail="review-orders"><strong class="fs-3 text-danger">@attentionOrders</strong><div class="text-muted">Đơn lỗi / cần xử lý</div>@if (Model.UnmatchedTransactions > 0){<small class="d-block text-warning">@Model.UnmatchedTransactions giao dịch chưa khớp</small>}<span class="revenue-stat-action">Xem chi tiết →</span></a></div>
            <div class="col-lg-3 col-6"><a class="status-panel revenue-stat-link h-100" asp-action="Index" asp-route-tab="overview" asp-route-detail="incomplete-orders"><strong class="fs-3">@Model.FailedOrders</strong><div class="text-muted">Đơn không hoàn tất</div><span class="revenue-stat-action">Xem chi tiết →</span></a></div>
            <div class="col-lg-3 col-6"><a class="status-panel revenue-stat-link h-100" asp-action="Index" asp-route-tab="overview" asp-route-detail="abandonment"><strong class="fs-3">@Model.AbandonmentRate.ToString("0.0")%</strong><div class="text-muted">Tỷ lệ không hoàn tất</div><span class="revenue-stat-action">Xem chi tiết →</span></a></div>
        </div>
    </section>

    @if (!string.IsNullOrEmpty(Model.DetailTitle))
    {
        <section class="status-panel revenue-detail-panel mb-4" aria-labelledby="revenue-detail-title">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                <div><span class="kicker">Chi tiết số liệu</span><h2 id="revenue-detail-title" class="h4 mb-1">@Model.DetailTitle</h2><p class="text-muted mb-0">@Model.DetailDescription</p></div>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-tab="overview">Đóng chi tiết</a>
            </div>
            @if (Model.DetailAccounts.Count > 0)
            {
                <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Khách hàng</th><th>Ngày tạo</th><th>Đơn thành công</th><th>Đã thanh toán</th></tr></thead><tbody>
                @foreach (var row in Model.DetailAccounts) { <tr><td><strong>@(string.IsNullOrWhiteSpace(row.User.FullName) ? "Chưa đặt tên" : row.User.FullName)</strong><small class="d-block">@row.User.Email</small><code class="small">@row.User.Id</code></td><td class="text-nowrap">@row.User.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@row.SuccessfulOrders</td><td>@row.PaidAmount.ToString("N0")đ</td></tr> }
                </tbody></table></div>
            }
            else if (Model.DetailSubscriptions.Count > 0)
            {
                <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Khách hàng</th><th>Gói</th><th>Bắt đầu</th><th>Hết hạn</th><th>Loại cấp</th></tr></thead><tbody>
                @foreach (var row in Model.DetailSubscriptions) { var subscription = row.Subscription!; <tr><td><strong>@row.DisplayName</strong><small class="d-block">@row.Email</small><code class="small">@row.UserId</code></td><td><strong>@subscription.Tier</strong><small class="d-block">@subscription.DurationMonths tháng</small></td><td>@subscription.StartsAt.ToDateTimeOffset().ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</td><td>@subscription.ExpiresAt.ToDateTimeOffset().ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</td><td>@(subscription.IsDemo ? "Demo" : subscription.LastOrderId.StartsWith("admin:") ? "Admin cấp" : "Thanh toán")</td></tr> }
                </tbody></table></div>
            }
            else if (Model.DetailOrders.Count > 0 || Model.DetailUnmatchedPayments.Count > 0)
            {
                @if (Model.DetailUnmatchedPayments.Count > 0) { <div class="alert alert-warning"><strong>Giao dịch chưa khớp đơn</strong><ul class="mb-0 mt-2">@foreach (var item in Model.DetailUnmatchedPayments) { <li>payOS @item.GetValueOrDefault("providerOrderCode") · @Convert.ToInt64(item.GetValueOrDefault("amountVnd") ?? 0).ToString("N0")đ · @item.GetValueOrDefault("reason")</li> }</ul></div> }
                <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Đơn / khách hàng</th><th>Gói</th><th>Số tiền</th><th>Trạng thái</th><th>Thời gian</th><th></th></tr></thead><tbody>
                @foreach (var row in Model.DetailOrders) { var order = row.Order; var warning = order.PaymentStatus == "NeedsReview" || order.FulfillmentStatus == "HeldForReview"; <tr><td><strong>@order.TransferReference</strong><small class="d-block">@row.Email</small><code class="small">@order.UserId</code></td><td>@order.Tier · @order.DurationMonths tháng</td><td><strong>@order.AmountVnd.ToString("N0")đ</strong>@if(row.ReceivedAmount > 0){<small class="d-block">Thực nhận @row.ReceivedAmount.ToString("N0")đ</small>}</td><td><span class="badge @(warning ? "bg-warning text-dark" : order.Status == "Paid" ? "bg-success" : order.Status == "Pending" ? "bg-primary" : "bg-secondary")">@(warning ? "Cần kiểm tra" : order.Status)</span></td><td>@order.CreatedAt.ToDateTimeOffset().ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</td><td><a class="btn btn-sm btn-outline-success" asp-action="Order" asp-route-id="@order.Id">Chi tiết</a></td></tr> }
                </tbody></table></div>
            }
            else
            {
                <p class="text-muted mb-0">Hiện chưa có bản ghi nào trong nhóm này.</p>
            }
        </section>
    }

    <section class="status-panel mb-4" aria-labelledby="ga4-title">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
            <div>
                <span class="kicker">Google Analytics 4</span>
                <h2 id="ga4-title" class="h4 mb-1">Thống kê lưu lượng truy cập & hành vi người dùng</h2>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge @(Model.Analytics.Available ? "bg-success" : "bg-secondary")">@(Model.Analytics.Available ? "Đang đồng bộ" : "Chưa có dữ liệu")</span>
                <a href="https://analytics.google.com" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-success">Mở GA4 Console &rarr;</a>
            </div>
        </div>
        @if (!Model.Analytics.Configured)
        {
            <p class="text-muted mb-0">Đã tích hợp GA4. Thêm <code>GoogleAnalytics__MeasurementId</code> và <code>GoogleAnalytics__PropertyId</code> trên Production để bắt đầu thu thập và hiển thị báo cáo.</p>
        }
        else if (!Model.Analytics.Available)
        {
            <div class="alert alert-warning mb-0">@Model.Analytics.Error</div>
        }
        else
        {
            <div class="row g-3 mb-4">
                <div class="col-lg-3 col-sm-6"><div class="analytics-metric"><strong>@Model.Analytics.ActiveUsers30Days.ToString("N0")</strong><span>Người truy cập (30 ngày)</span></div></div>
                <div class="col-lg-3 col-sm-6"><div class="analytics-metric"><strong>@Model.Analytics.Sessions30Days.ToString("N0")</strong><span>Phiên truy cập</span></div></div>
                <div class="col-lg-3 col-sm-6"><div class="analytics-metric"><strong>@Model.Analytics.PageViews30Days.ToString("N0")</strong><span>Lượt xem trang</span></div></div>
                <div class="col-lg-3 col-sm-6"><div class="analytics-metric"><strong>@Model.Analytics.FormattedAverageEngagement</strong><span>Thời gian tương tác TB</span></div></div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-xl-6">
                    <div class="status-panel h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="h6 text-uppercase mb-0">Lượt truy cập mỗi ngày (30 ngày qua)</h3>
                            <small class="text-muted">Tổng · Mới · Cũ · Phiên · Xem</small>
                        </div>

                        <div class="mb-3 p-3 rounded" style="background: rgba(208, 234, 144, 0.08); border: 1px solid rgba(208, 234, 144, 0.25);">
                            <span class="small text-muted d-block mb-1 text-uppercase fw-semibold" style="letter-spacing: .08em;">Trung bình 1 ngày (trong 30 ngày qua)</span>
                            <div class="d-flex flex-wrap gap-4 align-items-baseline">
                                <div><strong class="fs-5 text-success">@Model.Analytics.AverageDailyUsers30Days.ToString("N1")</strong> <small class="text-muted">user / ngày</small></div>
                                <div><strong class="fs-5 text-success">@Model.Analytics.AverageDailySessions30Days.ToString("N1")</strong> <small class="text-muted">phiên / ngày</small></div>
                                <div><strong class="fs-5 text-success">@Model.Analytics.AverageDailyPageViews30Days.ToString("N1")</strong> <small class="text-muted">lượt xem / ngày</small></div>
                            </div>
                        </div>

                        @if (Model.Analytics.DailyTrends.Count == 0)
                        {
                            <p class="text-muted small mb-0">Chưa có đủ dữ liệu theo ngày trong khoảng thời gian này.</p>
                        }
                        else
                        {
                            var maxDailyUsers = Math.Max(1, Model.Analytics.DailyTrends.Max(d => d.ActiveUsers));
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th style="width: 65px;">Ngày</th>
                                            <th>Mật độ</th>
                                            <th class="text-end" style="width: 55px;" title="Tổng số User trong ngày">Tổng</th>
                                            <th class="text-end text-success" style="width: 55px;" title="User mới truy cập lần đầu">Mới</th>
                                            <th class="text-end text-info" style="width: 55px;" title="User cũ quay lại">Cũ</th>
                                            <th class="text-end" style="width: 55px;">Phiên</th>
                                            <th class="text-end" style="width: 55px;">Xem</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var day in Model.Analytics.DailyTrends)
                                        {
                                            var pct = Math.Round((double)day.ActiveUsers / maxDailyUsers * 100);
                                            <tr>
                                                <td class="text-nowrap"><strong>@day.DisplayDate</strong></td>
                                                <td>
                                                    <div class="progress" style="height: 6px; background-color: var(--hair-soft);">
                                                        <div class="progress-bar" role="progressbar" style="width: @(pct)%; background-color: var(--green);" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                </td>
                                                <td class="text-end font-monospace">
                                                    @if (day.ActiveUsers > 0)
                                                    {
                                                        <button type="button" class="btn btn-link p-0 text-decoration-none fw-semibold text-light" onclick="openDailyUsersModal('@day.DateKey', '@day.DisplayDate', 'all')" title="Xem chi tiết người dùng ngày @day.DisplayDate">@day.ActiveUsers</button>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">0</span>
                                                    }
                                                </td>
                                                <td class="text-end font-monospace">
                                                    @if (day.NewUsers > 0)
                                                    {
                                                        <button type="button" class="btn btn-link p-0 text-decoration-none fw-bold text-success text-decoration-underline" onclick="openDailyUsersModal('@day.DateKey', '@day.DisplayDate', 'new')" title="Xem chi tiết User MỚI ngày @day.DisplayDate">@day.NewUsers</button>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">0</span>
                                                    }
                                                </td>
                                                <td class="text-end font-monospace">
                                                    @if (day.ReturningUsers > 0)
                                                    {
                                                        <button type="button" class="btn btn-link p-0 text-decoration-none fw-bold text-info text-decoration-underline" onclick="openDailyUsersModal('@day.DateKey', '@day.DisplayDate', 'returning')" title="Xem chi tiết User CŨ ngày @day.DisplayDate">@day.ReturningUsers</button>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">0</span>
                                                    }
                                                </td>
                                                <td class="text-end font-monospace text-muted">@day.Sessions</td>
                                                <td class="text-end font-monospace text-muted">@day.PageViews</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-xl-6">
                    <div class="status-panel h-100 d-flex flex-column justify-content-between">
                        <div>
                            <h3 class="h6 text-uppercase mb-3">Nguồn traffic</h3>
                            @if (Model.Analytics.TrafficSources.Count == 0)
                            {
                                <p class="text-muted small mb-0">Chưa ghi nhận nguồn traffic.</p>
                            }
                            else
                            {
                                @foreach (var source in Model.Analytics.TrafficSources)
                                {
                                    <div class="analytics-row"><span>@source.Label</span><strong>@source.Value.ToString("N0") phiên</strong></div>
                                }
                            }
                        </div>

                        <div class="p-3 mt-3 rounded" style="background: rgba(46, 125, 50, 0.08); border: 1px dashed var(--green);">
                            <h4 class="h6 mb-1 text-success">Theo dõi hành vi của TỪNG USER cụ thể</h4>
                            <p class="small text-muted mb-2">Hệ thống đã lưu nhật ký hoạt động trực tiếp vào cơ sở dữ liệu và tự động đồng bộ User-ID lên GA4.</p>
                            <p class="small text-muted mb-3">Xem chi tiết số lần ghé thăm, lần cuối vào web và toàn bộ dòng thời gian thao tác của từng tài khoản ngay trên web:</p>
                            <a asp-controller="Admin" asp-action="Users" class="btn btn-sm btn-outline-success">Xem nhật ký & hoạt động từng User &rarr;</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-7">
                    <h3 class="h6 text-uppercase mb-3">Trang được truy cập nhiều nhất & Thời gian trên trang</h3>
                    @if (Model.Analytics.PopularPages.Count == 0)
                    {
                        <p class="text-muted small mb-0">Chưa có dữ liệu trang.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Trang / Đường dẫn</th>
                                        <th class="text-end">Lượt xem</th>
                                        <th class="text-end">Số User</th>
                                        <th class="text-end">Thời gian TB</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Analytics.PopularPages)
                                    {
                                        <tr>
                                            <td>
                                                <strong class="d-block text-truncate" style="max-width: 300px;">@(string.IsNullOrWhiteSpace(item.Title) ? item.Path : item.Title)</strong>
                                                <code class="small text-muted">@item.Path</code>
                                            </td>
                                            <td class="text-end font-monospace">@item.Views.ToString("N0")</td>
                                            <td class="text-end font-monospace text-muted">@item.Users.ToString("N0")</td>
                                            <td class="text-end text-nowrap"><span class="badge bg-success-subtle text-success border border-success-subtle">@item.FormattedDuration</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="col-lg-5">
                    <h3 class="h6 text-uppercase mb-3">Trang ít lượt xem nhất (Cần tối ưu)</h3>
                    @if (Model.Analytics.LeastVisitedPages.Count == 0)
                    {
                        <p class="text-muted small mb-0">Chưa có dữ liệu trang ít xem.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Trang</th>
                                        <th class="text-end">Lượt xem</th>
                                        <th class="text-end">Thời gian TB</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Analytics.LeastVisitedPages)
                                    {
                                        <tr>
                                            <td>
                                                <span class="d-block text-truncate" style="max-width: 200px;">@(string.IsNullOrWhiteSpace(item.Title) ? item.Path : item.Title)</span>
                                                <code class="small text-muted">@item.Path</code>
                                            </td>
                                            <td class="text-end font-monospace text-warning">@item.Views.ToString("N0")</td>
                                            <td class="text-end text-nowrap"><span class="badge bg-secondary-subtle text-muted">@item.FormattedDuration</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    </section>

    <div class="row g-3">
        <div class="col-md-6"><div class="status-panel h-100"><h2 class="h5">Người dùng theo gói</h2>@foreach (var item in Model.UsersByTier){<div class="analytics-row"><span>@item.Key</span><strong>@item.Value</strong></div>}</div></div>
        <div class="col-md-6"><div class="status-panel h-100"><h2 class="h5">Gói bán chạy</h2><p class="display-6 fs-3 mb-0">@Model.BestSeller</p>@if (attentionOrders > 0){<a class="btn btn-outline-danger mt-3" asp-action="Index" asp-route-tab="orders" asp-route-status="NeedsReview">Xử lý @attentionOrders giao dịch cảnh báo</a>}</div></div>
    </div>
}

@if (Model.Tab is "orders" or "subscriptions" or "customers") {
<form method="get" class="row g-2 mb-4"><input type="hidden" name="tab" value="@Model.Tab" /><div class="col-md-7"><input class="form-control" name="query" value="@Model.Query" placeholder="Email, UID, mã đơn, mã payOS hoặc nội dung chuyển khoản" /></div>
@if (Model.Tab == "orders") { <div class="col-md-3"><select class="form-select" name="status"><option value="">Mọi trạng thái</option>@foreach (var s in new[] { "Pending", "Paid", "Cancelled", "Expired", "NeedsReview" }) { <option value="@s" selected="@(Model.Status == s)">@s</option> }</select></div> }
<div class="col-md-2"><button class="btn btn-success w-100">Tìm kiếm</button></div></form>
}

@if (Model.Tab == "orders")
{
    <div class="table-responsive status-panel revenue-orders">
        <table class="table align-middle mb-0">
            <thead><tr><th>Đơn / khách hàng</th><th>Gói</th><th>Số tiền</th><th>Trạng thái</th><th>Thời gian</th><th><span class="visually-hidden">Thao tác</span></th></tr></thead>
            <tbody>
            @foreach (var item in Model.UnmatchedPayments)
            {
                var transactionId = item.GetValueOrDefault("transactionId")?.ToString() ?? "";
                var isSystemTest = Convert.ToInt64(item.GetValueOrDefault("providerOrderCode") ?? 0) == 123 && Convert.ToInt64(item.GetValueOrDefault("amountVnd") ?? 0) == 3000 && item.GetValueOrDefault("reason")?.ToString() == "order_mapping_not_found";
                var receivedAt = item.GetValueOrDefault("receivedAt") is Google.Cloud.Firestore.Timestamp receivedTimestamp ? receivedTimestamp.ToDateTimeOffset().ToOffset(TimeSpan.FromHours(7)) : DateTimeOffset.MinValue;
                <tr class="revenue-order-warning">
                    <td><strong>payOS @item.GetValueOrDefault("providerOrderCode")</strong><small class="d-block">Không xác định khách hàng</small><small class="d-block text-danger">@item.GetValueOrDefault("reason")</small></td>
                    <td><strong>@(isSystemTest ? "TEST HỆ THỐNG" : "GIAO DỊCH CHƯA KHỚP")</strong><small class="d-block">Không cấp thuê bao</small></td>
                    <td><strong>@Convert.ToInt64(item.GetValueOrDefault("amountVnd") ?? 0).ToString("N0")đ</strong><small class="d-block">Không tính doanh thu</small></td>
                    <td><span class="badge bg-warning text-dark">Chưa khớp đơn</span></td>
                    <td class="text-nowrap">@(receivedAt == DateTimeOffset.MinValue ? "—" : receivedAt.ToString("dd/MM/yyyy HH:mm"))</td>
                    <td>
                        <form asp-action="IgnoreTransaction" asp-route-id="@transactionId" method="post" class="d-flex flex-column gap-1" style="min-width: 190px">
                            <input class="form-control form-control-sm" name="reason" required minlength="5" placeholder="Lý do xử lý" />
                            <button class="btn btn-sm btn-outline-warning text-nowrap">Đánh dấu đã xử lý</button>
                        </form>
                    </td>
                </tr>
            }
            @foreach (var row in Model.Orders)
            {
                var order = row.Order;
                var warning = order.PaymentStatus == "NeedsReview" || order.FulfillmentStatus == "HeldForReview";
                <tr class="@(warning ? "revenue-order-warning" : "")">
                    <td><a asp-action="Order" asp-route-id="@order.Id"><strong>@order.TransferReference</strong></a><small class="d-block text-break">@row.Email</small><small class="d-block text-muted text-break">@order.UserId</small></td>
                    <td><strong>@order.Tier</strong><small class="d-block">@order.DurationMonths tháng · @order.Sku</small></td>
                    <td><strong>@order.AmountVnd.ToString("N0")đ</strong>@if (row.ReceivedAmount > 0){<small class="d-block">Thực nhận @row.ReceivedAmount.ToString("N0")đ</small>}</td>
                    <td><span class="badge @(warning ? "bg-warning text-dark" : order.Status == "Paid" ? "bg-success" : order.Status == "Pending" ? "bg-primary" : "bg-secondary")">@(warning ? "Cần kiểm tra" : order.Status)</span>@if (!string.IsNullOrEmpty(row.ReviewReason)){<small class="d-block text-danger mt-1">@row.ReviewReason</small>}</td>
                    <td class="text-nowrap">@order.CreatedAt.ToDateTimeOffset().ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy")<small class="d-block">@order.CreatedAt.ToDateTimeOffset().ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm")</small></td>
                    <td><a class="btn btn-sm btn-outline-success text-nowrap" asp-action="Order" asp-route-id="@order.Id">Chi tiết</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (Model.Tab is "subscriptions" or "customers") {
<div class="table-responsive status-panel"><table class="table align-middle mb-0"><thead><tr><th>Khách hàng</th><th>Gói hiện tại</th><th>Sử dụng</th><th>Cấp/gia hạn thủ công</th><th></th></tr></thead><tbody>
@foreach (var row in Model.Subscriptions) { <tr><td><strong>@row.DisplayName</strong><br/><small>@row.Email<br/><code>@row.UserId</code></small></td><td>@(row.Subscription?.Tier ?? "Basic") @if (row.Subscription != null) { <span class="badge @(row.Subscription.IsDemo ? "bg-warning text-dark" : row.Subscription.LastOrderId.StartsWith("admin:") ? "bg-info" : "bg-success")">@(row.Subscription.IsDemo ? "DEMO" : row.Subscription.LastOrderId.StartsWith("admin:") ? "ADMIN" : "THANH TOÁN")</span><br/><small>Đến @row.Subscription.ExpiresAt.ToDateTimeOffset().ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</small> }</td><td>@row.Usage.PlantCount cây<br/>AI đã dùng: @row.Usage.AiUsed@if (row.Usage.AiReserved > 0) { <br/><small>Đang xử lý: @row.Usage.AiReserved</small> }@if (Model.Tab == "customers") { <form asp-action="SetAiUsage" asp-route-userId="@row.UserId" method="post" class="mt-2 d-flex flex-column gap-1" style="min-width: 190px"><div class="input-group input-group-sm"><span class="input-group-text">AI</span><input class="form-control" type="number" name="aiUsed" min="0" max="1000000" value="@row.Usage.AiUsed" required aria-label="Số lượt AI đã dùng"/><button class="btn btn-outline-success" type="submit">Cập nhật</button></div><input class="form-control form-control-sm" name="reason" required minlength="5" placeholder="Lý do điều chỉnh"/></form> }</td><td><form asp-action="Grant" method="post" class="d-flex flex-wrap gap-1"><input type="hidden" name="userId" value="@row.UserId"/><select class="form-select form-select-sm w-auto" name="sku">@foreach (var plan in Model.Plans) { <option value="@plan.Plan.Sku">@plan.Plan.Tier @plan.Plan.DurationMonths tháng</option> }</select><input class="form-control form-control-sm w-auto" type="number" name="months" min="1" max="36" value="1" aria-label="Số tháng"/><input class="form-control form-control-sm" name="reason" required minlength="5" placeholder="Lý do bắt buộc"/><button class="btn btn-sm btn-success">Cấp</button></form></td><td>@if (row.Subscription != null) { <form asp-action="Revoke" asp-route-userId="@row.UserId" method="post" class="d-flex gap-1"><input class="form-control form-control-sm" name="reason" required minlength="5" placeholder="Lý do thu hồi"/><button class="btn btn-sm btn-outline-danger">Thu hồi</button></form> } @if (Model.Tab == "customers") { <form asp-action="AddNote" asp-route-userId="@row.UserId" method="post" class="d-flex gap-1 mt-2"><input class="form-control form-control-sm" name="note" required minlength="5" placeholder="Ghi chú nội bộ"/><button class="btn btn-sm btn-outline-secondary">Lưu</button></form> }</td></tr> }
</tbody></table></div>
}

@if (Model.Tab == "plans") {
<div class="row g-3">@foreach (var row in Model.Plans) { <div class="col-lg-6"><form asp-action="UpdatePlan" asp-route-sku="@row.Plan.Sku" method="post" class="status-panel h-100"><div class="d-flex justify-content-between"><h2 class="h5">@row.Plan.Tier · @row.Plan.DurationMonths tháng</h2><strong>@row.Plan.AmountVnd.ToString("N0")đ</strong></div><p class="small text-muted">SKU @row.Plan.Sku · phiên bản @row.Version · @(row.Plan.PlantLimit == 0 ? "không giới hạn cây" : $"{row.Plan.PlantLimit} cây") · @row.Plan.MonthlyAiLimit AI/tháng. Giá được khóa trong mã để tránh sửa nhầm.</p><div class="form-check form-switch mb-2"><input type="hidden" name="enabled" value="false"/><input class="form-check-input" type="checkbox" name="enabled" value="true" checked="@row.Enabled"/><label class="form-check-label">Cho phép đăng ký</label></div><textarea class="form-control mb-2" name="description" placeholder="Mô tả">@row.Description</textarea><textarea class="form-control mb-2" name="benefits" placeholder="Quyền lợi hiển thị">@row.Benefits</textarea><input class="form-control mb-2" name="reason" required minlength="5" placeholder="Lý do thay đổi"/><button class="btn btn-success">Lưu cấu hình</button></form></div> }</div>
}

@if (Model.Tab == "audit") {
<div class="table-responsive status-panel"><table class="table align-middle mb-0"><thead><tr><th>Thời gian</th><th>Quản trị viên</th><th>Hành động</th><th>Đối tượng</th><th>Lý do</th></tr></thead><tbody>@foreach (var log in Model.AuditLogs) { <tr><td>@log.CreatedAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yy HH:mm:ss")</td><td>@log.AdminEmail</td><td><code>@log.Action</code></td><td>@log.TargetType<br/><small>@log.TargetId</small></td><td>@log.Reason</td></tr> }</tbody></table></div>
}

<!-- Modal xem chi tiết người dùng mới / cũ theo ngày -->
<div class="modal fade" id="dailyUsersModal" tabindex="-1" aria-labelledby="dailyUsersModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content" style="background-color: var(--bg-surface, #15221c); color: var(--ink, #e0ede4); border: 1px solid var(--hair-soft, rgba(208, 234, 144, 0.2));">
            <div class="modal-header border-bottom border-secondary-subtle">
                <div>
                    <h5 class="modal-title h5 mb-1" id="dailyUsersModalTitle">Chi tiết người dùng</h5>
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-light active" id="btnTabAll" onclick="filterDailyUsers('all')">
                                Tất cả (<span id="modalCountAll">0</span>)
                            </button>
                            <button type="button" class="btn btn-outline-success" id="btnTabNew" onclick="filterDailyUsers('new')">
                                User Mới (<span id="modalCountNew">0</span>)
                            </button>
                            <button type="button" class="btn btn-outline-info" id="btnTabReturning" onclick="filterDailyUsers('returning')">
                                User Cũ (<span id="modalCountReturning">0</span>)
                            </button>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-3">
                <div id="dailyUsersLoading" class="text-center py-5">
                    <div class="spinner-border text-success" role="status"></div>
                    <p class="text-muted mt-2 mb-0">Đang tải danh sách người dùng và các trang đã xem...</p>
                </div>
                <div id="dailyUsersEmpty" class="text-center py-5 d-none">
                    <div class="text-muted mb-2">
                        <svg width="42" height="42" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    </div>
                    <h6 class="text-muted mb-1" id="dailyUsersEmptyMsg">Không có dữ liệu người dùng trong mục này.</h6>
                    <small class="text-muted d-block">Danh tính cụ thể (tên, email, các trang đã xem) được tự động ghi nhận khi người dùng thao tác trên website HomePlant.</small>
                </div>
                <div id="dailyUsersContainer" class="d-flex flex-column gap-3 d-none"></div>
            </div>
            <div class="modal-footer border-top border-secondary-subtle">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
let allDailyUsers = [];
let currentFilterType = 'all';

function openDailyUsersModal(dateKey, displayDate, type) {
    currentFilterType = type || 'all';
    document.getElementById('dailyUsersModalTitle').innerHTML = 'Người dùng truy cập ngày <span class="text-success font-monospace">' + displayDate + '</span>';
    
    const loading = document.getElementById('dailyUsersLoading');
    const empty = document.getElementById('dailyUsersEmpty');
    const container = document.getElementById('dailyUsersContainer');

    loading.classList.remove('d-none');
    empty.classList.add('d-none');
    container.classList.add('d-none');
    container.innerHTML = '';

    const modal = new bootstrap.Modal(document.getElementById('dailyUsersModal'));
    modal.show();

    fetch('/Admin/Revenue/DailyUsers?date=' + encodeURIComponent(dateKey) + '&type=all')
        .then(res => res.json())
        .then(data => {
            loading.classList.add('d-none');
            allDailyUsers = (data && data.users) ? data.users : [];

            const countNew = allDailyUsers.filter(u => u.isNew).length;
            const countRet = allDailyUsers.filter(u => !u.isNew).length;

            document.getElementById('modalCountAll').innerText = allDailyUsers.length;
            document.getElementById('modalCountNew').innerText = countNew;
            document.getElementById('modalCountReturning').innerText = countRet;

            filterDailyUsers(currentFilterType);
        })
        .catch(err => {
            loading.classList.add('d-none');
            empty.classList.remove('d-none');
            document.getElementById('dailyUsersEmptyMsg').innerText = 'Không thể tải dữ liệu: ' + err.message;
        });
}

function filterDailyUsers(type) {
    currentFilterType = type;
    document.getElementById('btnTabAll').classList.toggle('active', type === 'all');
    document.getElementById('btnTabNew').classList.toggle('active', type === 'new');
    document.getElementById('btnTabReturning').classList.toggle('active', type === 'returning');

    const empty = document.getElementById('dailyUsersEmpty');
    const container = document.getElementById('dailyUsersContainer');
    container.innerHTML = '';

    let filtered = allDailyUsers;
    if (type === 'new') filtered = allDailyUsers.filter(u => u.isNew);
    if (type === 'returning') filtered = allDailyUsers.filter(u => !u.isNew);

    if (filtered.length === 0) {
        empty.classList.remove('d-none');
        container.classList.add('d-none');
        return;
    }

    empty.classList.add('d-none');
    container.classList.remove('d-none');

    filtered.forEach((u) => {
        const card = document.createElement('div');
        card.className = 'p-3 rounded border';
        card.style.background = 'rgba(255, 255, 255, 0.03)';
        card.style.borderColor = 'rgba(208, 234, 144, 0.15)';

        const isNewBadge = u.isNew 
            ? '<span class="badge bg-success-subtle text-success border border-success-subtle">User Mới</span>' 
            : '<span class="badge bg-info-subtle text-info border border-info-subtle">User Cũ</span>';
            
        const guestBadge = u.isGuest 
            ? '<span class="badge bg-secondary-subtle text-muted">Khách chưa đăng nhập</span>' 
            : '<span class="badge bg-primary-subtle text-primary">Tài khoản</span>';

        let activitiesHtml = '';
        if (u.activities && u.activities.length > 0) {
            activitiesHtml = `
                <div class="mt-3 pt-2 border-top border-secondary-subtle">
                    <small class="text-muted text-uppercase fw-semibold d-block mb-2" style="letter-spacing: .05em; font-size: 0.75rem;">
                        Các trang đã xem trong phiên (${u.activities.length} lượt):
                    </small>
                    <div class="d-flex flex-column gap-2" style="max-height: 220px; overflow-y: auto;">
                        ${u.activities.map(a => `
                            <div class="d-flex align-items-baseline gap-2 small">
                                <span class="font-monospace text-muted" style="font-size: 0.8rem; min-width: 58px;">${a.time}</span>
                                <span class="badge bg-secondary-subtle text-light px-1">${a.action || 'Xem'}</span>
                                <strong class="text-success text-truncate">${a.title}</strong>
                                <code class="text-muted small">${a.path}</code>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
        } else {
            activitiesHtml = '<div class="mt-2 text-muted small fst-italic">Chưa có chi tiết trang cụ thể cho phiên này.</div>';
        }

        const avatar = u.avatarUrl || ('https://i.pravatar.cc/150?u=' + encodeURIComponent(u.uid));

        card.innerHTML = `
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <img src="${avatar}" class="rounded-circle" width="36" height="36" style="object-fit: cover; border: 1px solid rgba(208, 234, 144, 0.3);" alt="${u.fullName}"/>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <strong class="text-light">${u.fullName}</strong>
                            ${isNewBadge}
                            ${guestBadge}
                        </div>
                        <small class="text-muted">${u.email || u.uid}</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 font-monospace small">
                    <span class="badge bg-dark border border-secondary-subtle text-light">${u.sessionCount || 1} phiên</span>
                    <span class="badge bg-dark border border-secondary-subtle text-success">${u.pageViewCount || (u.activities ? u.activities.length : 1)} lượt xem</span>
                </div>
            </div>
            ${activitiesHtml}
        `;
        container.appendChild(card);
    });
}
</script>
}

