@model HomePlant.ViewModels.RevenueDashboardVM
@using HomePlant.Models
@{
    ViewData["Title"] = "Doanh thu";
    var tabs = new[] { ("overview", "Tổng quan"), ("orders", "Đơn thanh toán"), ("subscriptions", "Thuê bao"), ("plans", "Bảng giá"), ("customers", "Khách hàng"), ("audit", "Nhật ký") };
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div><span class="kicker">Quản trị</span><h1 class="mb-1">Doanh thu</h1><p class="text-muted mb-0">Thanh toán, thuê bao và hỗ trợ khách hàng trong một nơi.</p></div>
    <span class="badge @(Model.PayOsConfigured ? "bg-success" : "bg-danger")">payOS: @(Model.PayOsConfigured ? "Đã cấu hình" : "Thiếu cấu hình")</span>
</div>
<nav class="revenue-tabs mb-4" aria-label="Các mục doanh thu">
@foreach (var tab in tabs) { <a class="btn @(Model.Tab == tab.Item1 ? "btn-success" : "btn-outline-secondary")" asp-action="Index" asp-route-tab="@tab.Item1">@tab.Item2</a> }
</nav>

@if (Model.Tab == "overview")
{
    var attentionOrders = Model.NeedsReviewOrders + Model.UnmatchedTransactions;
    <section class="revenue-summary" aria-labelledby="business-summary-title">
        <div class="d-flex justify-content-between align-items-end gap-3 mb-3">
            <div><span class="kicker">Vận hành</span><h2 id="business-summary-title" class="h3 mb-0">Tình hình kinh doanh</h2></div>
            <small class="text-muted">Tài khoản mới và doanh thu tính trong 30 ngày gần nhất</small>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6"><div class="admin-stat-card h-100"><div class="stat-number">@Model.TotalAccounts</div><div class="stat-label">Tổng tài khoản</div><small class="text-muted">+@Model.NewAccounts30Days tài khoản mới</small></div></div>
            <div class="col-xl-3 col-md-6"><div class="admin-stat-card h-100"><div class="stat-number">@Model.ActiveSubscriptions</div><div class="stat-label">Gói đang hoạt động</div></div></div>
            <div class="col-xl-3 col-md-6"><div class="admin-stat-card h-100"><div class="stat-number">@Model.PayingCustomers</div><div class="stat-label">Người đã thanh toán</div><small class="text-muted">@Model.SuccessfulOrders giao dịch thành công</small></div></div>
            <div class="col-xl-3 col-md-6"><div class="admin-stat-card h-100"><div class="stat-number">@Model.Revenue30Days.ToString("N0")đ</div><div class="stat-label">Doanh thu 30 ngày</div><small class="text-muted">Hôm nay @Model.RevenueToday.ToString("N0")đ · 7 ngày @Model.Revenue7Days.ToString("N0")đ</small></div></div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-lg-3 col-6"><div class="status-panel h-100"><strong class="fs-3">@Model.PendingOrders</strong><div class="text-muted">Đơn đang chờ</div></div></div>
            <div class="col-lg-3 col-6"><div class="status-panel h-100"><strong class="fs-3 text-danger">@attentionOrders</strong><div class="text-muted">Đơn lỗi / cần xử lý</div>@if (Model.UnmatchedTransactions > 0){<small class="d-block text-warning">@Model.UnmatchedTransactions giao dịch chưa khớp</small>}</div></div>
            <div class="col-lg-3 col-6"><div class="status-panel h-100"><strong class="fs-3">@Model.FailedOrders</strong><div class="text-muted">Đơn không hoàn tất</div></div></div>
            <div class="col-lg-3 col-6"><div class="status-panel h-100"><strong class="fs-3">@Model.AbandonmentRate.ToString("0.0")%</strong><div class="text-muted">Tỷ lệ không hoàn tất</div></div></div>
        </div>
    </section>

    <section class="status-panel mb-4" aria-labelledby="ga4-title">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
            <div><span class="kicker">Google Analytics 4</span><h2 id="ga4-title" class="h4 mb-1">Lưu lượng truy cập · 30 ngày</h2></div>
            <span class="badge @(Model.Analytics.Available ? "bg-success" : "bg-secondary")">@(Model.Analytics.Available ? "Đang đồng bộ" : "Chưa có dữ liệu")</span>
        </div>
        @if (!Model.Analytics.Configured)
        {
            <p class="text-muted mb-0">Đã tích hợp GA4. Thêm <code>GoogleAnalytics__MeasurementId</code> và <code>GoogleAnalytics__PropertyId</code> trên Production để bắt đầu thu thập và hiển thị báo cáo.</p>
        }
        else if (!Model.Analytics.Available)
        {
            <div class="alert alert-warning mb-0">@Model.Analytics.Error</div>
        }
        else
        {
            <div class="row g-3 mb-4">
                <div class="col-md-4"><div class="analytics-metric"><strong>@Model.Analytics.ActiveUsers30Days.ToString("N0")</strong><span>Người truy cập</span></div></div>
                <div class="col-md-4"><div class="analytics-metric"><strong>@Model.Analytics.Sessions30Days.ToString("N0")</strong><span>Phiên truy cập</span></div></div>
                <div class="col-md-4"><div class="analytics-metric"><strong>@Model.Analytics.PageViews30Days.ToString("N0")</strong><span>Lượt xem trang</span></div></div>
            </div>
            <div class="row g-4">
                <div class="col-lg-5"><h3 class="h6 text-uppercase">Nguồn traffic</h3>@foreach (var item in Model.Analytics.TrafficSources){<div class="analytics-row"><span>@item.Label</span><strong>@item.Value.ToString("N0")</strong></div>}</div>
                <div class="col-lg-7"><h3 class="h6 text-uppercase">Trang phổ biến</h3>@foreach (var item in Model.Analytics.PopularPages){<div class="analytics-row"><span>@item.Label</span><strong>@item.Value.ToString("N0")</strong></div>}</div>
            </div>
        }
    </section>

    <div class="row g-3">
        <div class="col-md-6"><div class="status-panel h-100"><h2 class="h5">Người dùng theo gói</h2>@foreach (var item in Model.UsersByTier){<div class="analytics-row"><span>@item.Key</span><strong>@item.Value</strong></div>}</div></div>
        <div class="col-md-6"><div class="status-panel h-100"><h2 class="h5">Gói bán chạy</h2><p class="display-6 fs-3 mb-0">@Model.BestSeller</p>@if (attentionOrders > 0){<a class="btn btn-outline-danger mt-3" asp-action="Index" asp-route-tab="orders" asp-route-status="NeedsReview">Xử lý @attentionOrders giao dịch cảnh báo</a>}</div></div>
    </div>
}

@if (Model.Tab is "orders" or "subscriptions" or "customers") {
<form method="get" class="row g-2 mb-4"><input type="hidden" name="tab" value="@Model.Tab" /><div class="col-md-7"><input class="form-control" name="query" value="@Model.Query" placeholder="Email, UID, mã đơn, mã payOS hoặc nội dung chuyển khoản" /></div>
@if (Model.Tab == "orders") { <div class="col-md-3"><select class="form-select" name="status"><option value="">Mọi trạng thái</option>@foreach (var s in new[] { "Pending", "Paid", "Cancelled", "Expired", "NeedsReview" }) { <option value="@s" selected="@(Model.Status == s)">@s</option> }</select></div> }
<div class="col-md-2"><button class="btn btn-success w-100">Tìm kiếm</button></div></form>
}

@if (Model.Tab == "orders")
{
    @if (Model.UnmatchedPayments.Count > 0)
    {
        <div class="alert alert-danger"><strong>Giao dịch chưa khớp đơn</strong><ul class="mb-0 mt-2">@foreach (var item in Model.UnmatchedPayments){<li>payOS @item.GetValueOrDefault("providerOrderCode") · @Convert.ToInt64(item.GetValueOrDefault("amountVnd") ?? 0).ToString("N0")đ · @item.GetValueOrDefault("reason")</li>}</ul></div>
    }
    <div class="table-responsive status-panel revenue-orders">
        <table class="table align-middle mb-0">
            <thead><tr><th>Đơn / khách hàng</th><th>Gói</th><th>Số tiền</th><th>Trạng thái</th><th>Thời gian</th><th><span class="visually-hidden">Thao tác</span></th></tr></thead>
            <tbody>
            @foreach (var row in Model.Orders)
            {
                var order = row.Order;
                var warning = order.PaymentStatus == "NeedsReview" || order.FulfillmentStatus == "HeldForReview";
                <tr class="@(warning ? "revenue-order-warning" : "")">
                    <td><a asp-action="Order" asp-route-id="@order.Id"><strong>@order.TransferReference</strong></a><small class="d-block text-break">@row.Email</small><small class="d-block text-muted text-break">@order.UserId</small></td>
                    <td><strong>@order.Tier</strong><small class="d-block">@order.DurationMonths tháng · @order.Sku</small></td>
                    <td><strong>@order.AmountVnd.ToString("N0")đ</strong>@if (row.ReceivedAmount > 0){<small class="d-block">Thực nhận @row.ReceivedAmount.ToString("N0")đ</small>}</td>
                    <td><span class="badge @(warning ? "bg-warning text-dark" : order.Status == "Paid" ? "bg-success" : order.Status == "Pending" ? "bg-primary" : "bg-secondary")">@(warning ? "Cần kiểm tra" : order.Status)</span>@if (!string.IsNullOrEmpty(row.ReviewReason)){<small class="d-block text-danger mt-1">@row.ReviewReason</small>}</td>
                    <td class="text-nowrap">@order.CreatedAt.ToDateTimeOffset().ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy")<small class="d-block">@order.CreatedAt.ToDateTimeOffset().ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm")</small></td>
                    <td><a class="btn btn-sm btn-outline-success text-nowrap" asp-action="Order" asp-route-id="@order.Id">Chi tiết</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (Model.Tab is "subscriptions" or "customers") {
<div class="table-responsive status-panel"><table class="table align-middle mb-0"><thead><tr><th>Khách hàng</th><th>Gói hiện tại</th><th>Sử dụng</th><th>Cấp/gia hạn thủ công</th><th></th></tr></thead><tbody>
@foreach (var row in Model.Subscriptions) { <tr><td><strong>@row.DisplayName</strong><br/><small>@row.Email<br/><code>@row.UserId</code></small></td><td>@(row.Subscription?.Tier ?? "Basic") @if (row.Subscription != null) { <span class="badge @(row.Subscription.IsDemo ? "bg-warning text-dark" : row.Subscription.LastOrderId.StartsWith("admin:") ? "bg-info" : "bg-success")">@(row.Subscription.IsDemo ? "DEMO" : row.Subscription.LastOrderId.StartsWith("admin:") ? "ADMIN" : "THANH TOÁN")</span><br/><small>Đến @row.Subscription.ExpiresAt.ToDateTimeOffset().ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</small> }</td><td>@row.Usage.PlantCount cây<br/>AI đã dùng: @row.Usage.AiUsed@if (row.Usage.AiReserved > 0) { <br/><small>Đang xử lý: @row.Usage.AiReserved</small> }@if (Model.Tab == "customers") { <form asp-action="SetAiUsage" asp-route-userId="@row.UserId" method="post" class="mt-2 d-flex flex-column gap-1" style="min-width: 190px"><div class="input-group input-group-sm"><span class="input-group-text">AI</span><input class="form-control" type="number" name="aiUsed" min="0" max="1000000" value="@row.Usage.AiUsed" required aria-label="Số lượt AI đã dùng"/><button class="btn btn-outline-success" type="submit">Cập nhật</button></div><input class="form-control form-control-sm" name="reason" required minlength="5" placeholder="Lý do điều chỉnh"/></form> }</td><td><form asp-action="Grant" method="post" class="d-flex flex-wrap gap-1"><input type="hidden" name="userId" value="@row.UserId"/><select class="form-select form-select-sm w-auto" name="sku">@foreach (var plan in Model.Plans) { <option value="@plan.Plan.Sku">@plan.Plan.Tier @plan.Plan.DurationMonths tháng</option> }</select><input class="form-control form-control-sm w-auto" type="number" name="months" min="1" max="36" value="1" aria-label="Số tháng"/><input class="form-control form-control-sm" name="reason" required minlength="5" placeholder="Lý do bắt buộc"/><button class="btn btn-sm btn-success">Cấp</button></form></td><td>@if (row.Subscription != null) { <form asp-action="Revoke" asp-route-userId="@row.UserId" method="post" class="d-flex gap-1"><input class="form-control form-control-sm" name="reason" required minlength="5" placeholder="Lý do thu hồi"/><button class="btn btn-sm btn-outline-danger">Thu hồi</button></form> } @if (Model.Tab == "customers") { <form asp-action="AddNote" asp-route-userId="@row.UserId" method="post" class="d-flex gap-1 mt-2"><input class="form-control form-control-sm" name="note" required minlength="5" placeholder="Ghi chú nội bộ"/><button class="btn btn-sm btn-outline-secondary">Lưu</button></form> }</td></tr> }
</tbody></table></div>
}

@if (Model.Tab == "plans") {
<div class="row g-3">@foreach (var row in Model.Plans) { <div class="col-lg-6"><form asp-action="UpdatePlan" asp-route-sku="@row.Plan.Sku" method="post" class="status-panel h-100"><div class="d-flex justify-content-between"><h2 class="h5">@row.Plan.Tier · @row.Plan.DurationMonths tháng</h2><strong>@row.Plan.AmountVnd.ToString("N0")đ</strong></div><p class="small text-muted">SKU @row.Plan.Sku · phiên bản @row.Version · @(row.Plan.PlantLimit == 0 ? "không giới hạn cây" : $"{row.Plan.PlantLimit} cây") · @row.Plan.MonthlyAiLimit AI/tháng. Giá được khóa trong mã để tránh sửa nhầm.</p><div class="form-check form-switch mb-2"><input type="hidden" name="enabled" value="false"/><input class="form-check-input" type="checkbox" name="enabled" value="true" checked="@row.Enabled"/><label class="form-check-label">Cho phép đăng ký</label></div><textarea class="form-control mb-2" name="description" placeholder="Mô tả">@row.Description</textarea><textarea class="form-control mb-2" name="benefits" placeholder="Quyền lợi hiển thị">@row.Benefits</textarea><input class="form-control mb-2" name="reason" required minlength="5" placeholder="Lý do thay đổi"/><button class="btn btn-success">Lưu cấu hình</button></form></div> }</div>
}

@if (Model.Tab == "audit") {
<div class="table-responsive status-panel"><table class="table align-middle mb-0"><thead><tr><th>Thời gian</th><th>Quản trị viên</th><th>Hành động</th><th>Đối tượng</th><th>Lý do</th></tr></thead><tbody>@foreach (var log in Model.AuditLogs) { <tr><td>@log.CreatedAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yy HH:mm:ss")</td><td>@log.AdminEmail</td><td><code>@log.Action</code></td><td>@log.TargetType<br/><small>@log.TargetId</small></td><td>@log.Reason</td></tr> }</tbody></table></div>
}
