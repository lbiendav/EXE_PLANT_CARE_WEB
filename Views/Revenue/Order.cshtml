@model HomePlant.ViewModels.RevenueOrderDetailVM
@using System.Text.Json
@{ ViewData["Title"] = "Chi tiết đơn"; var order = Model.Row.Order; }
<div class="d-flex justify-content-between align-items-start mb-4"><div><a asp-action="Index" asp-route-tab="orders">← Đơn thanh toán</a><h1 class="mt-2">@order.TransferReference</h1><p class="text-muted">@order.Id</p></div><span class="badge @(order.Status == "Paid" ? "bg-success" : "bg-secondary")">@order.Status</span></div>
<div class="row g-3"><div class="col-lg-7"><div class="status-panel mb-3"><h2 class="h5">Thông tin đối soát</h2><dl class="row mb-0"><dt class="col-sm-4">Khách hàng</dt><dd class="col-sm-8">@Model.Row.DisplayName · @Model.Row.Email<br/><code>@order.UserId</code></dd><dt class="col-sm-4">Gói</dt><dd class="col-sm-8">@order.Tier · @order.DurationMonths tháng</dd><dt class="col-sm-4">Dự kiến</dt><dd class="col-sm-8">@order.AmountVnd.ToString("N0")đ</dd><dt class="col-sm-4">Đã ghi nhận</dt><dd class="col-sm-8">@Model.Row.ReceivedAmount.ToString("N0")đ</dd><dt class="col-sm-4">Mã payOS</dt><dd class="col-sm-8">@order.ProviderOrderCode · @order.ProviderPaymentLinkId</dd><dt class="col-sm-4">Webhook</dt><dd class="col-sm-8">@order.PaymentStatus / @order.FulfillmentStatus</dd></dl></div>
<div class="status-panel"><h2 class="h5">Payload webhook đã xác minh</h2>@if (Model.Transactions.Count == 0) { <p class="text-muted">Chưa nhận webhook đã xác minh.</p> } @foreach (var item in Model.Transactions) { <pre class="small bg-light p-3 rounded text-wrap">@JsonSerializer.Serialize(item, new JsonSerializerOptions { WriteIndented = true })</pre> }</div></div>
<div class="col-lg-5"><div class="status-panel mb-3"><h2 class="h5">Thao tác an toàn</h2><form asp-action="SyncOrder" asp-route-id="@order.Id" method="post" class="mb-3"><label class="form-label">Đồng bộ lại từ payOS</label><input class="form-control mb-2" name="reason" required minlength="5" placeholder="Lý do bắt buộc"/><button class="btn btn-success">Đồng bộ và xử lý idempotent</button></form>@if (order.Status == "Pending") { <form asp-action="CancelOrder" asp-route-id="@order.Id" method="post" class="mb-3"><label class="form-label">Hủy đơn đang chờ</label><input class="form-control mb-2" name="reason" required minlength="5" placeholder="Lý do bắt buộc"/><button class="btn btn-outline-danger">Hủy đơn</button></form> } @if (order.Status == "Paid") { <form asp-action="ResendReceipt" asp-route-id="@order.Id" method="post"><label class="form-label">Gửi lại email xác nhận</label><input class="form-control mb-2" name="reason" required minlength="5" placeholder="Lý do bắt buộc"/><button class="btn btn-outline-success">Gửi email</button></form> }</div><div class="status-panel"><h2 class="h5">Nhật ký đơn</h2>@foreach (var log in Model.AuditLogs) { <div class="border-bottom py-2"><strong>@log.Action</strong><br/><small>@log.AdminEmail · @log.CreatedAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yy HH:mm")<br/>@log.Reason</small></div> }</div></div></div>
