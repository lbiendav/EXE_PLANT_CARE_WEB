@model List<HomePlant.Models.CareLogModel>

@{
    ViewData["Title"] = "Lịch sử chăm sóc";
}

<a asp-controller="Plant" asp-action="Details" asp-route-id="@ViewBag.PlantId" class="back-link">
    ← Chi tiết cây
</a>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="kicker">Nhật ký</span>
        <h1 class="mb-0">Lịch sử chăm sóc</h1>
    </div>

    <a asp-action="Create"
       asp-route-plantId="@ViewBag.PlantId"
       class="btn btn-success">
        + Ghi nhật ký
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-garden text-center py-5 px-4">
        <span class="kicker d-block mb-3">Chưa có hoạt động</span>
        <h3>Bắt đầu cuốn nhật ký chăm cây</h3>
        <p class="text-muted">Ghi lần tưới, bón phân hoặc thay chậu đầu tiên để lịch nhắc tự cập nhật.</p>
        <a asp-action="Create" asp-route-plantId="@ViewBag.PlantId" class="btn btn-success mt-2">Ghi nhật ký đầu tiên</a>
    </div>
}
else
{
<div class="card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">

            <thead>
                <tr>
                    <th>Hoạt động</th>
                    <th>Ghi chú</th>
                    <th>Ngày</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>@(item.ActionType switch
                            {
                                "Watering" => "Tưới nước",
                                "Fertilizing" => "Bón phân",
                                "Repotting" => "Thay chậu",
                                "Observation" => "Quan sát",
                                _ => item.ActionType
                            })</td>

                        <td>@item.Note</td>

                        <td class="text-muted">@item.CreatedAt.ToDateTime().AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>

                        <td class="text-end">
<form asp-action="Delete" asp-route-plantId="@ViewBag.PlantId" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa bản ghi này?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Xóa</button>
                                </form>
                        </td>

                    </tr>
                }

            </tbody>

        </table>
    </div>
</div>
}
