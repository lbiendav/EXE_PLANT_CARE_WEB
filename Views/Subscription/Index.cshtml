@model HomePlant.ViewModels.SubscriptionVM?
@{
    ViewData["Title"] = "Gói của tôi";
}
@if (ViewBag.LoadError == true || Model == null)
{
    <div class="status-panel"><h1>Chưa tải được thông tin gói</h1><p>Dữ liệu của bạn không bị thay đổi. Hãy thử lại sau.</p><a class="btn btn-success" href="/Subscription">Thử lại</a></div>
    return;
}
@{
    var viewModel = Model!;
    var current = viewModel.Current;
    var plantPercent = Math.Min(100, current.PlantLimit == 0 ? 100 : viewModel.Usage.PlantCount * 100 / current.PlantLimit);
    var aiPercent = Math.Min(100, current.MonthlyAiLimit == 0 ? 100 : viewModel.Usage.AiUsed * 100 / current.MonthlyAiLimit);
}
<section>
    <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start mb-4">
        <div><span class="kicker">Gói của tôi</span><h1>@current.Tier @if (current.Subscription?.IsDemo == true) { <span class="demo-badge">DEMO</span> }</h1></div>
        <a class="btn btn-success" href="/Plans">@(current.IsPaidActive ? "Gia hạn" : "Nâng cấp")</a>
    </div>
    <div class="row g-4">
        <div class="col-lg-6"><div class="status-panel h-100"><h2>Trạng thái</h2><p><strong>@(current.IsPaidActive ? "Đang hoạt động" : "Free")</strong></p>
            @if (current.IsPaidActive && current.Subscription != null) { <p>Bắt đầu: @current.Subscription.StartsAt.ToDateTimeOffset().ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p><p>Hết hạn: @current.Subscription.ExpiresAt.ToDateTimeOffset().ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p><p>Kỳ hạn vừa mua: @current.Subscription.DurationMonths tháng</p> }
        </div></div>
        <div class="col-lg-6"><div class="status-panel h-100"><h2>Hạn mức tháng này</h2>
            <p>Cây: <strong>@viewModel.Usage.PlantCount / @current.PlantLimit</strong></p><div class="progress"><div class="progress-bar" style="width:@plantPercent%"></div></div>
            @if (viewModel.Usage.PlantCount > current.PlantLimit) { <small class="text-warning">Bạn đang vượt giới hạn; dữ liệu cũ vẫn được giữ.</small> }
            <p class="mt-3">AI đã dùng: <strong>@viewModel.Usage.AiUsed / @current.MonthlyAiLimit</strong></p><div class="progress"><div class="progress-bar" style="width:@aiPercent%"></div></div>
            <small>Đặt lại: @viewModel.Usage.ResetsAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</small>
        </div></div>
    </div>
    <h2 class="mt-5">Lịch sử đơn</h2>
    @if (ViewBag.HistoryLoadError == true) { <div class="alert alert-warning">Thông tin gói vẫn hoạt động, nhưng lịch sử đơn tạm thời chưa tải được. Vui lòng thử lại sau.</div> }
    else if (viewModel.Orders.Count == 0) { <p class="text-muted">Chưa có đơn nào.</p> }
    else { <div class="table-responsive"><table class="table"><thead><tr><th>Mã</th><th>Gói</th><th>Số tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody>
    @foreach (var order in viewModel.Orders) { <tr><td>@order.TransferReference</td><td>@order.Tier · @order.DurationMonths tháng</td><td>@order.AmountVnd.ToString("N0")đ</td><td>@order.Status @if(order.IsDemo){<span class="demo-badge">DEMO</span>}</td><td>@if(order.Status=="Pending"){<a href="/Checkout/@order.Id">Tiếp tục</a>}</td></tr> }
    </tbody></table></div> }
</section>
